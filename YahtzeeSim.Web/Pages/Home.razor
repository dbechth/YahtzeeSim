    private async Task ResumeSavedGameAsync()
    {
        _showResumePrompt = false;
        if (_pendingSaveJson != null && _engine.TryLoad(_pendingSaveJson))
        {
            _isGameStarted = true;
            _noticeText = string.Empty;
            RefreshAll(true);
        }

        _pendingSaveJson = null;
        await PersistAsync();
    }

    private async Task DiscardSavedGameAsync()
    {
        _showResumePrompt = false;
        _pendingSaveJson = null;
        await RemoveStorageAsync(SaveKey);
    }

    private void StartGameButtonClicked()
    {
        if (HasProgress)
        {
            _confirm = new ConfirmRequest(
                "Abandon current game?",
                "Your current game will be lost.",
                "New Game",
                () =>
                {
                    _showModePicker = true;
                    return Task.CompletedTask;
                });
            return;
        }

        _showModePicker = true;
    }

    private async Task AcceptConfirmAsync()
    {
        var request = _confirm;
        _confirm = null;
        if (request != null)
        {
            await request.OnAccept();
        }
    }

    private void CancelConfirm()
    {
        _confirm = null;
    }

    private void CancelGameMode()
    {
        _showModePicker = false;
    }

    private void OnConfirmKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CancelConfirm();
        }
    }

    private void OnModePickerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CancelGameMode();
        }
    }

    // Escape only closes the Yahtzee picker; the picker after New Game must be answered.
    private void OnColorPickerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _allowKeepCurrentColor)
        {
            KeepCurrentColor();
        }
    }

    private void WheelKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowLeft":
                _pickHue = (_pickHue + 355) % 360;
                break;
            case "ArrowRight":
                _pickHue = (_pickHue + 5) % 360;
                break;
            case "ArrowUp":
                _pickSaturation = Math.Min(1, _pickSaturation + 0.05);
                break;
            case "ArrowDown":
                _pickSaturation = Math.Max(0, _pickSaturation - 0.05);
                break;
        }
    }

    private async Task SelectGameModeAsync(GameMode mode)
    {
        _showModePicker = false;
        _engine.Reset(mode);
        _isGameStarted = true;
        _noticeText = string.Empty;
        _announcement = $"New {ModeLabel} game started.";
        DismissSplash();
        RefreshAll(false);
        await RemoveStorageAsync(SaveKey);
        OpenColorPicker("Pick Pen Color", false);
    }

    private void OpenColorPicker(string title, bool allowKeepCurrent)
    {
        _colorPickerTitle = title;
        _allowKeepCurrentColor = allowKeepCurrent;
        SetPickFromHex(_currentPenColorHex);
        _showColorPicker = true;
    }

    private void WheelPointer(PointerEventArgs e)
    {
        if (e.Type == "pointermove" && e.Buttons == 0)
        {
            return;
        }

        double radius = WheelSize / 2;
        double dx = e.OffsetX - radius;
        double dy = e.OffsetY - radius;
        double angle = Math.Atan2(dx, -dy) * 180 / Math.PI;
        _pickHue = (angle + 360) % 360;
        _pickSaturation = Math.Min(1, Math.Sqrt((dx * dx) + (dy * dy)) / radius);
    }

    private void LightnessChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out double percent))
        {
            _pickLightness = Math.Clamp(percent, 15, 85) / 100;
        }
    }

    private static string Percent(double fraction) =>
        (fraction * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private string MarkerLeft() => Percent(0.5 + (0.5 * _pickSaturation * Math.Sin(_pickHue * Math.PI / 180)));

    private string MarkerTop() => Percent(0.5 - (0.5 * _pickSaturation * Math.Cos(_pickHue * Math.PI / 180)));

    private void SetPickFromHex(string hex)
    {
        if (!TryParseHexColor(hex, out int r, out int g, out int b))
        {
            return;
        }

        double rf = r / 255d, gf = g / 255d, bf = b / 255d;
        double max = Math.Max(rf, Math.Max(gf, bf));
        double min = Math.Min(rf, Math.Min(gf, bf));
        double delta = max - min;
        double light = (max + min) / 2;
        double hue = 0;
        if (delta > 0)
        {
            hue = max == rf ? ((gf - bf) / delta) % 6
                : max == gf ? ((bf - rf) / delta) + 2
                : ((rf - gf) / delta) + 4;
            hue = (hue * 60 + 360) % 360;
        }

        double saturation = delta == 0 ? 0 : delta / (1 - Math.Abs((2 * light) - 1));
        _pickHue = hue;
        _pickSaturation = Math.Clamp(saturation, 0, 1);
        _pickLightness = Math.Clamp(light, 0.15, 0.85);
    }

    private static string HslToHex(double hue, double saturation, double lightness)
    {
        double c = (1 - Math.Abs((2 * lightness) - 1)) * saturation;
        double x = c * (1 - Math.Abs((hue / 60 % 2) - 1));
        double m = lightness - (c / 2);
        (double r, double g, double b) = (int)(hue / 60) switch
        {
            0 => (c, x, 0d),
            1 => (x, c, 0d),
            2 => (0d, c, x),
            3 => (0d, x, c),
            4 => (x, 0d, c),
            _ => (c, 0d, x)
        };

        static int ToByte(double v) => (int)Math.Round(Math.Clamp(v, 0, 1) * 255);
        return $"#{ToByte(r + m):X2}{ToByte(g + m):X2}{ToByte(b + m):X2}";
    }

