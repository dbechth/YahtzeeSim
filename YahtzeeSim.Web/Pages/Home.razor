    private void KeepCurrentColor()
    {
        _showColorPicker = false;
    }

    private void RollButtonPressed()
    {
        if (_isGameStarted && _engine.CanRoll)
        {
            _isRollPressVisual = true;
        }
    }

    private void RollButtonReleased()
    {
        _isRollPressVisual = false;
    }

    private async Task RollButtonClickedAsync()
    {
        _isRollPressVisual = false;
        if (!_isGameStarted || !_engine.CanRoll)
        {
            return;
        }

        if (!_engine.RollDice())
        {
            return;
        }

        await Actions.RecordAsync(_engine, GameActionType.Roll, TurnState.Capture(_engine));
        _noticeText = string.Empty;
        _announcement = $"Roll {_engine.RollCount} of {YahtzeeGameEngine.RollsPerTurn}. Dice: {string.Join(", ", _engine.Dice.Select(d => d.Value))}."
            + (_engine.IsYahtzeeRolled ? " Yahtzee!" : string.Empty)
            + (_engine.IsJokerRoll ? " Joker roll." : string.Empty);
        await RefreshOddsAfterRenderAsync();
        if (_engine.IsYahtzeeRolled)
        {
            _ = ShowYahtzeeSplashAsync();
        }

        await PersistAsync();
    }

    private async Task ShowYahtzeeSplashAsync()
    {
        int token = ++_splashToken;
        _showYahtzeeSplash = true;
        await Task.Delay(SplashMilliseconds);
        if (token == _splashToken)
        {
            _showYahtzeeSplash = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void DismissSplash()
    {
        _splashToken++;
        _showYahtzeeSplash = false;
    }

    private async Task ToggleHoldAsync(int dieId)
    {
        if (!_isGameStarted)
        {
            return;
        }

        if (!_engine.ToggleHold(dieId))
        {
            return;
        }

        var state = TurnState.Capture(_engine);
        bool isHeld = _engine.Dice.First(d => d.Id == dieId).IsHeld;
        await Actions.RecordAsync(_engine, isHeld ? GameActionType.Hold : GameActionType.Unhold, state, dieId: dieId);
        RefreshAll(true);
        await PersistAsync();
    }

    private async Task UndoAsync()
    {
        if (_isGameStarted && _engine.CanUndo)
        {
            bool wasComplete = _engine.IsGameComplete;
            Guid gameId = _engine.GameId;
            if (_engine.Undo())
            {
                var state = TurnState.Capture(_engine);
                await Actions.RecordAsync(_engine, GameActionType.Undo, state);
                if (wasComplete)
                {
                    await Queue.DiscardAsync(gameId);
                }

                _noticeText = string.Empty;
                _announcement = "Last score undone.";
                await RefreshOddsAfterRenderAsync();
                await PersistAsync();
                await Actions.FlushAsync();
            }
        }
    }

    private async Task ApplyScoreAsync(int gameIndex, ScoreCategory category)
    {
        if (!_isGameStarted)
        {
            return;
        }

        switch (GetPickStatus(gameIndex, category))
        {
            case PickStatus.Valid:
                await FinishScoreAsync(() => _engine.TryApplyScore(gameIndex, category, _currentPenColorHex), gameIndex, category);
                break;

            case PickStatus.Scratch:
                _confirm = new ConfirmRequest(
                    "Record a zero?",
                    $"{ScoreRules.GetDisplayName(category)} in Game {gameIndex + 1} does not score with these dice. Mark it with an X (0 points)?",
                    "Mark X",
                    async () => await FinishScoreAsync(() => _engine.TryScratch(gameIndex, category, _currentPenColorHex), gameIndex, category));
                break;

            default:
                _noticeText = _engine.RollCount <= 0
                    ? "Roll at least once before selecting a score cell."
                    : "That cell cannot be used for this roll.";
                break;
        }
    }

    private async Task FinishScoreAsync(Func<ScoreResult> apply, int gameIndex, ScoreCategory category)
    {
        // Scoring clears the dice, so capture them first.
        var scored = TurnState.Capture(_engine);
        var result = apply();
        if (!result.Applied)
        {
            return;
        }

        await Actions.RecordAsync(
            _engine,
            result.WasScratch ? GameActionType.Scratch : GameActionType.Score,
            scored,
            gameIndex: gameIndex,
            category: category,
            points: result.Score,
            bonus: result.YahtzeeBonusAwarded);

        string name = ScoreRules.GetDisplayName(category);
        string recorded = result.WasScratch
            ? $"{name} in Game {gameIndex + 1} recorded as X."
            : $"{result.Score} in {name}, Game {gameIndex + 1}.";
        _noticeText = result.YahtzeeBonusAwarded
            ? "Yahtzee bonus! +100"
            : result.WasScratch ? recorded : string.Empty;
        _announcement = recorded
            + (result.YahtzeeBonusAwarded ? " Yahtzee bonus, 100 points." : string.Empty)
            + (_engine.IsGameComplete ? " Game complete." : string.Empty);
        RefreshAll(false);
        await PersistAsync();

        if (result.WasYahtzee)
        {
            OpenColorPicker("Yahtzee! Pick a pen color", true);
        }

        if (_engine.IsGameComplete)
        {
            await SubmitFinishedGameAsync();
        }

        await Actions.FlushAsync();
    }

    private PickStatus GetPickStatus(int gameIndex, ScoreCategory category)
    {
        return _isGameStarted ? _engine.GetPickStatus(gameIndex, category) : PickStatus.Unavailable;
    }

    // Shows the dice first, then fills in the odds so a slow device still feels responsive.
    private async Task RefreshOddsAfterRenderAsync()
    {
        RefreshAll(false);
        StateHasChanged();
        await Task.Delay(1);
        RefreshAll(true);
    }

    private void RefreshAll(bool recalculateProbabilities)
    {
        if (_isGameStarted && recalculateProbabilities && _engine.RollCount > 0)
        {
            _probabilities = _engine.CalculateProbabilities();
        }
        else
        {
            _probabilities = ScoreRules.ScoringCategories.ToDictionary(c => c, _ => 0d);
        }
    }

    private (string Headline, string Detail) GetStatus()
    {
        if (!_isGameStarted)
        {
            return ("Tap New Game", "Choose Single or Full Sheet to begin.");
        }

        if (_engine.IsGameComplete)
        {
            return ("Game complete", "Tap New Game to play again.");
        }

        if (_engine.RollCount == 0)
        {
            return ("Ready to roll", "Roll up to three times, then score one open box.");
        }

        string headline = $"Roll {_engine.RollCount} of {YahtzeeGameEngine.RollsPerTurn}";
        if (_engine.IsJokerRoll)
        {
            return (headline, "Joker! Use the matching upper box, or any open lower box at full value.");
        }

        return (headline, _engine.AwaitingScoreSelection ? "Choose a score." : "Choose a score, or hold dice and roll again.");
    }

    private static readonly string[] FaceNames = ["", "one", "two", "three", "four", "five", "six"];

    private bool IsShownHeld(DieState die)
    {
        // After the third roll the engine holds every die; that is not the player's choice, so it is not shown as held.
        return die.IsHeld && !_engine.AwaitingScoreSelection;
    }

    private string GetDieLabel(DieState die, int index)
    {
        if (die.Value <= 0)
        {
            return $"Die {index + 1}, not rolled";
        }

        return $"Die {index + 1}, showing {FaceNames[die.Value]}{(IsShownHeld(die) ? ", held" : string.Empty)}";
    }

    private string GetScoreLabel(int gameIndex, ScoreCategory category, ScoreCellState cell, PickStatus status)
    {
        string state;
        if (cell.IsFilled)
        {
            state = cell.IsScratch ? "scratched, X" : $"scored {cell.Value}";
        }
        else if (status == PickStatus.Valid)
        {
            state = "open, scores with these dice";
        }
        else if (status == PickStatus.Scratch)
        {
            state = "open, does not score, can be scratched";
        }
        else if (!_engine.IsCardEnabled(gameIndex))
        {
            state = "not in play";
        }
        else
        {
            state = _engine.RollCount <= 0 ? "open, roll first" : "not available for these dice";
        }

        return $"{ScoreRules.GetDisplayName(category)}, Game {gameIndex + 1}: {state}";
    }

    private string GetBonusLabel(int gameIndex)
    {
        int count = _engine.Cards[gameIndex].YahtzeeBonusCount;
        return $"Game {gameIndex + 1} Yahtzee bonuses: {count}";
    }
    // Pips lit on the 3x3 grid of a die face, row by row.
    private static readonly string[] PipPatterns = ["", "....#....", "#.......#", "#...#...#", "#.#...#.#", "#.#.#.#.#", "#.##.##.#"];

    private bool[] GetDiePips(DieState die)
    {
        string pattern = (_isRollPressVisual && !die.IsHeld) || die.Value <= 0 ? string.Empty : PipPatterns[die.Value];
        return Enumerable.Range(0, 9).Select(i => i < pattern.Length && pattern[i] == '#').ToArray();
    }

    private string GetDieVisualClass(DieState die)
    {
        if (_isRollPressVisual && !die.IsHeld)
        {
            return "rolling";
        }

        return IsShownHeld(die) ? "held" : string.Empty;
    }

    private string GetColumnClass(int gameIndex)
    {
        return _engine.IsCardEnabled(gameIndex) ? string.Empty : "col-off";
    }

    private string GetBonusMarks(int gameIndex)
    {
        return new string('\u2713', _engine.Cards[gameIndex].YahtzeeBonusCount);
    }

    private string GetProbabilityText(ScoreCategory category)
    {
        return _engine.RollCount > 0 && _probabilities.TryGetValue(category, out var p)
            ? p.ToString("P1")
            : string.Empty;
    }

    private string GetUpperPaceText(int gameIndex)
    {
        int net = ScoreRules.UpperCategories.Sum(c => ScoreRules.GetUpperPaceDelta(_engine.Cards[gameIndex], c));
        string sign = net > 0 ? "+" : string.Empty;
        return _engine.IsCardEnabled(gameIndex) ? $"{sign}{net}" : "--";
    }

    private string GetPaceToneClass(int gameIndex)
    {
        if (!_engine.IsCardEnabled(gameIndex))
        {
            return "pace-neutral";
        }

        int net = ScoreRules.UpperCategories.Sum(c => ScoreRules.GetUpperPaceDelta(_engine.Cards[gameIndex], c));
        if (net > 0)
        {
            return "pace-up";
        }

        if (net < 0)
        {
            return "pace-down";
        }

        return "pace-neutral";
    }

    private string GetCardTotalDisplay()
    {
        bool showCardTotal = _engine.Mode == GameMode.Single
            ? _engine.Cards[0].IsComplete
            : _engine.Cards.All(c => c.IsComplete);

        if (!showCardTotal)
        {
            return "--";
        }

        int cardTotal = _engine.Cards.Sum(c => c.GameTotal ?? 0);
        return cardTotal.ToString();
    }

    private static string GetScoreClass(ScoreCellState cell, PickStatus status)
    {
        if (cell.IsFilled)
        {
            return "filled";
        }

        return status switch
        {
            PickStatus.Valid => "valid",
            PickStatus.Scratch => "scratch",
            _ => "empty"
        };
    }

    private static string GetScoreButtonStyle(ScoreCellState cell, bool enabled)
    {
        if (cell.IsFilled)
        {
            string textColor = GetContrastingTextColor(cell.PenColorHex);
            string border = enabled ? "#1F2937" : "#374151";
            return $"background:{cell.PenColorHex};color:{textColor};border-color:{border};";
        }

        return string.Empty;
    }

    // Picks black or white text, whichever contrasts more with the pen colour (WCAG relative luminance).
    private static string GetContrastingTextColor(string backgroundHex)
    {
        if (!TryParseHexColor(backgroundHex, out int r, out int g, out int b))
        {
            return "#FFFFFF";
        }

        double background = RelativeLuminance(r, g, b);
        double darkText = RelativeLuminance(0x11, 0x18, 0x27);
        double contrastWithDark = (background + 0.05) / (darkText + 0.05);
        double contrastWithWhite = 1.05 / (background + 0.05);
        return contrastWithDark >= contrastWithWhite ? "#111827" : "#FFFFFF";
    }

    private static double RelativeLuminance(int r, int g, int b)
    {
        static double Channel(int value)
        {
            double v = value / 255d;
            return v <= 0.03928 ? v / 12.92 : Math.Pow((v + 0.055) / 1.055, 2.4);
        }

        return (0.2126 * Channel(r)) + (0.7152 * Channel(g)) + (0.0722 * Channel(b));
    }
    private static bool TryParseHexColor(string hex, out int r, out int g, out int b)
    {
        r = g = b = 0;
        if (string.IsNullOrWhiteSpace(hex))
        {
            return false;
        }

        string cleaned = hex.TrimStart('#');
        if (cleaned.Length != 6)
        {
            return false;
        }

        return int.TryParse(cleaned.AsSpan(0, 2), System.Globalization.NumberStyles.HexNumber, null, out r)
            && int.TryParse(cleaned.AsSpan(2, 2), System.Globalization.NumberStyles.HexNumber, null, out g)
            && int.TryParse(cleaned.AsSpan(4, 2), System.Globalization.NumberStyles.HexNumber, null, out b);
    }
}

