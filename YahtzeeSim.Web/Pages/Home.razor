@page "/"
@inject IJSRuntime JS

<PageTitle>YahtzeeSim</PageTitle>

<div class="game-page">
    <section class="top-bar">
        <h1>Yahtzee</h1>
        <div class="status">@GetStatusText()</div>
        <button class="new-game" @onclick="StartGameButtonClicked">New Game</button>
    </section>

    @if (!string.IsNullOrWhiteSpace(_noticeText))
    {
        <div class="notice">@_noticeText</div>
    }

    <section class="dice-row">
        @foreach (var die in _engine.Dice)
        {
            bool canHold = _isGameStarted && _engine.RollCount > 0 && !_engine.AwaitingScoreSelection;
            <button
                class="die @GetDieVisualClass(die)"
                disabled="@(!canHold)"
                @onclick="() => ToggleHoldAsync(die.Id)">
                @GetDieVisualText(die)
            </button>
        }
    </section>

    <section class="action-row">
        <button
            class="roll"
            disabled="@(!_isGameStarted || !_engine.CanRoll)"
            @onpointerdown="RollButtonPressed"
            @onpointerup="RollButtonReleased"
            @onpointerleave="RollButtonReleased"
            @onpointercancel="RollButtonReleased"
            @onclick="RollButtonClickedAsync">Roll</button>
        <button class="undo" disabled="@(!_isGameStarted || !_engine.CanUndo)" @onclick="UndoAsync">Undo</button>
    </section>

    <section class="score-wrap">
        <table class="score-grid" aria-label="Yahtzee Score Grid">
            <colgroup>
                <col class="col-category" />
                <col class="col-prob" />
                <col class="col-game" />
                <col class="col-game" />
                <col class="col-game" />
                <col class="col-game" />
                <col class="col-game" />
                <col class="col-game" />
            </colgroup>
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Odds</th>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <th class="@GetColumnClass(game)">G@(game + 1)</th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr class="pace-row">
                    <td>Upper Pace</td>
                    <td>vs 3x target</td>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td class="pace-tone @GetPaceToneClass(game) @GetColumnClass(game)">@GetUpperPaceText(game)</td>
                    }
                </tr>

                <tr class="section-row"><td colspan="8">Upper Section</td></tr>
                @foreach (var category in ScoreRules.UpperCategories)
                {
                    @ScoreRow(category)
                }

                <tr class="totals-row">
                    <td>Upper Total</td>
                    <td></td>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td class="@GetColumnClass(game)">@(_engine.Cards[game].UpperSubtotal?.ToString() ?? "--")</td>
                    }
                </tr>

                <tr class="totals-row">
                    <td>Bonus <span class="hint">35 if 63+</span></td>
                    <td></td>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td class="@GetColumnClass(game)">@(_engine.Cards[game].UpperBonus?.ToString() ?? "--")</td>
                    }
                </tr>

                <tr class="section-row"><td colspan="8">Lower Section</td></tr>
                @foreach (var category in ScoreRules.LowerCategories)
                {
                    @ScoreRow(category)
                }

                <tr class="yahtzee-bonus-row">
                    <td class="category-cell">Yahtzee Bonus <span class="hint">100 each</span></td>
                    <td></td>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td class="bonus-marks @GetColumnClass(game)" aria-label="Yahtzee bonuses">@GetBonusMarks(game)</td>
                    }
                </tr>

                <tr class="totals-row">
                    <td>Lower Total</td>
                    <td></td>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td class="@GetColumnClass(game)">@(_engine.Cards[game].LowerSubtotal?.ToString() ?? "--")</td>
                    }
                </tr>

                <tr class="totals-row grand-row">
                    <td>Game Total</td>
                    <td></td>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td class="@GetColumnClass(game)">@(_engine.Cards[game].GameTotal?.ToString() ?? "--")</td>
                    }
                </tr>

                <tr class="totals-row card-total-row">
                    <td>Card Total</td>
                    <td></td>
                    <td>@GetCardTotalDisplay()</td>
                    @for (int game = 1; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td></td>
                    }
                </tr>
            </tbody>
        </table>
    </section>

    @if (_engine.Mode == GameMode.FullSheet && _engine.Cards.All(c => c.IsComplete))
    {
        <section class="summary-panel">
            <h2>Full Sheet Complete</h2>
            <div class="summary-text">
                @for (int gameIndex = 0; gameIndex < YahtzeeGameEngine.GameCount; gameIndex++)
                {
                    var card = _engine.Cards[gameIndex];
                    <div>Game @(gameIndex + 1): U @(card.UpperSubtotal ?? 0), L @(card.LowerSubtotal ?? 0), B @(card.UpperBonus ?? 0), T @(card.GameTotal ?? 0)</div>
                }
                <div>Series Card Total: @(_engine.Cards.Sum(c => c.GameTotal ?? 0))</div>
            </div>
        </section>
    }
</div>

@code {
    private RenderFragment ScoreRow(ScoreCategory category) => __builder =>
    {
        <tr>
            <td class="category-cell">@ScoreRules.GetDisplayName(category)</td>
            <td class="prob-cell">@GetProbabilityText(category)</td>
            @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
            {
                var gameIndex = game;
                var cell = _engine.Cards[game].Scores[category];
                var status = GetPickStatus(gameIndex, category);
                bool enabled = status != PickStatus.Unavailable;
                <td class="@GetColumnClass(game)">
                    <button
                        class="score-btn @GetScoreClass(cell, status)"
                        style="@GetScoreButtonStyle(cell, enabled)"
                        disabled="@(!enabled)"
                        @onclick="() => ApplyScoreAsync(gameIndex, category)">
                        @cell.DisplayText
                    </button>
                </td>
            }
        </tr>
    };
}

@if (_showResumePrompt)
{
    <div class="overlay">
        <div class="modal">
            <h3>Resume your game?</h3>
            <p class="modal-text">A game in progress was saved on this device.</p>
            <div class="modal-actions">
                <button @onclick="ResumeSavedGameAsync">Resume</button>
                <button class="secondary" @onclick="DiscardSavedGameAsync">Discard</button>
            </div>
        </div>
    </div>
}

@if (_confirm != null)
{
    <div class="overlay">
        <div class="modal">
            <h3>@_confirm.Title</h3>
            <p class="modal-text">@_confirm.Message</p>
            <div class="modal-actions">
                <button @onclick="AcceptConfirmAsync">@_confirm.AcceptText</button>
                <button class="secondary" @onclick="CancelConfirm">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_showModePicker)
{
    <div class="overlay">
        <div class="modal">
            <h3>Choose Game Mode</h3>
            <div class="modal-actions mode-actions">
                <button @onclick="() => SelectGameModeAsync(GameMode.Single)">Single</button>
                <button @onclick="() => SelectGameModeAsync(GameMode.FullSheet)">Full Sheet</button>
                <button class="secondary" @onclick="CancelGameMode">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_showColorPicker)
{
    <div class="overlay">
        <div class="modal color-modal">
            <h3>@_colorPickerTitle</h3>
            <div class="swatch-grid">
                @foreach (var hex in PenColors)
                {
                    <button class="swatch" style="background-color:@hex" @onclick="() => PickPenColorAsync(hex)" aria-label="Select @hex"></button>
                }
            </div>
            @if (_allowKeepCurrentColor)
            {
                <div class="modal-actions">
                    <button class="secondary" @onclick="KeepCurrentColor">Keep Current</button>
                </div>
            }
        </div>
    </div>
}

@if (_showYahtzeeSplash)
{
    <div class="overlay yahtzee-splash" @onclick="DismissSplash" role="alert">
        <div class="splash-text">YAHTZEE!</div>
    </div>
}

@code {
    private sealed record ConfirmRequest(string Title, string Message, string AcceptText, Func<Task> OnAccept);

    private const string SaveKey = "yahtzeesim.save";
    private const string PenKey = "yahtzeesim.pen";
    private const int SplashMilliseconds = 2000;

    private readonly YahtzeeGameEngine _engine = new();
    private Dictionary<ScoreCategory, double> _probabilities = new();
    private string _currentPenColorHex = "#1D2939";
    private bool _isGameStarted;
    private bool _isRollPressVisual;
    private string _noticeText = string.Empty;

    private bool _showModePicker;
    private bool _showColorPicker;
    private bool _allowKeepCurrentColor;
    private string _colorPickerTitle = "Pick Pen Color";
    private bool _showResumePrompt;
    private string? _pendingSaveJson;
    private ConfirmRequest? _confirm;
    private bool _showYahtzeeSplash;
    private int _splashToken;

    private static readonly string[] PenColors =
    [
        "#7F1D1D", "#B91C1C", "#EF4444", "#FCA5A5",
        "#7C2D12", "#C2410C", "#F97316", "#FDBA74",
        "#854D0E", "#CA8A04", "#FACC15", "#FDE68A",
        "#166534", "#16A34A", "#4ADE80", "#BBF7D0",
        "#1E3A8A", "#2563EB", "#60A5FA", "#BFDBFE",
        "#581C87", "#7E22CE", "#C084FC", "#E9D5FF"
    ];

    protected override void OnInitialized()
    {
        _engine.Reset(GameMode.Single);
        RefreshAll(false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            string? pen = await JS.InvokeAsync<string?>("localStorage.getItem", PenKey);
            if (!string.IsNullOrWhiteSpace(pen) && TryParseHexColor(pen, out _, out _, out _))
            {
                _currentPenColorHex = pen;
            }

            string? saved = await JS.InvokeAsync<string?>("localStorage.getItem", SaveKey);
            if (!string.IsNullOrWhiteSpace(saved))
            {
                if (new YahtzeeGameEngine().TryLoad(saved))
                {
                    _pendingSaveJson = saved;
                    _showResumePrompt = true;
                    StateHasChanged();
                }
                else
                {
                    await RemoveStorageAsync(SaveKey);
                }
            }
        }
        catch (JSException)
        {
            // Storage can be unavailable (private mode); the game still works without saving.
        }
    }

    private bool HasProgress => _isGameStarted
        && !_engine.IsGameComplete
        && (_engine.RollCount > 0 || _engine.Cards.Any(c => c.Scores.Values.Any(s => s.IsFilled)));

    private async Task PersistAsync()
    {
        try
        {
            if (HasProgress)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", SaveKey, _engine.Serialize());
            }
            else
            {
                await RemoveStorageAsync(SaveKey);
            }
        }
        catch (JSException)
        {
            // Saving is best effort.
        }
    }

    private async Task RemoveStorageAsync(string key)
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", key);
        }
        catch (JSException)
        {
        }
    }

    private async Task ResumeSavedGameAsync()
    {
        _showResumePrompt = false;
        if (_pendingSaveJson != null && _engine.TryLoad(_pendingSaveJson))
        {
            _isGameStarted = true;
            _noticeText = string.Empty;
            RefreshAll(true);
        }

        _pendingSaveJson = null;
        await PersistAsync();
    }

    private async Task DiscardSavedGameAsync()
    {
        _showResumePrompt = false;
        _pendingSaveJson = null;
        await RemoveStorageAsync(SaveKey);
    }

    private void StartGameButtonClicked()
    {
        if (HasProgress)
        {
            _confirm = new ConfirmRequest(
                "Abandon current game?",
                "Your current game will be lost.",
                "New Game",
                () =>
                {
                    _showModePicker = true;
                    return Task.CompletedTask;
                });
            return;
        }

        _showModePicker = true;
    }

    private async Task AcceptConfirmAsync()
    {
        var request = _confirm;
        _confirm = null;
        if (request != null)
        {
            await request.OnAccept();
        }
    }

    private void CancelConfirm()
    {
        _confirm = null;
    }

    private void CancelGameMode()
    {
        _showModePicker = false;
    }

    private async Task SelectGameModeAsync(GameMode mode)
    {
        _showModePicker = false;
        _engine.Reset(mode);
        _isGameStarted = true;
        _noticeText = string.Empty;
        DismissSplash();
        RefreshAll(false);
        await RemoveStorageAsync(SaveKey);
        OpenColorPicker("Pick Pen Color", false);
    }

    private void OpenColorPicker(string title, bool allowKeepCurrent)
    {
        _colorPickerTitle = title;
        _allowKeepCurrentColor = allowKeepCurrent;
        _showColorPicker = true;
    }

    private async Task PickPenColorAsync(string hex)
    {
        _currentPenColorHex = hex;
        _showColorPicker = false;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", PenKey, hex);
        }
        catch (JSException)
        {
        }
    }

    private void KeepCurrentColor()
    {
        _showColorPicker = false;
    }

    private void RollButtonPressed()
    {
        if (_isGameStarted && _engine.CanRoll)
        {
            _isRollPressVisual = true;
        }
    }

    private void RollButtonReleased()
    {
        _isRollPressVisual = false;
    }

    private async Task RollButtonClickedAsync()
    {
        _isRollPressVisual = false;
        if (!_isGameStarted || !_engine.CanRoll || !_engine.RollDice())
        {
            return;
        }

        _noticeText = string.Empty;
        await RefreshOddsAfterRenderAsync();
        if (_engine.IsYahtzeeRolled)
        {
            _ = ShowYahtzeeSplashAsync();
        }

        await PersistAsync();
    }

    private async Task ShowYahtzeeSplashAsync()
    {
        int token = ++_splashToken;
        _showYahtzeeSplash = true;
        await Task.Delay(SplashMilliseconds);
        if (token == _splashToken)
        {
            _showYahtzeeSplash = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void DismissSplash()
    {
        _splashToken++;
        _showYahtzeeSplash = false;
    }

    private async Task ToggleHoldAsync(int dieId)
    {
        if (!_isGameStarted)
        {
            return;
        }

        _engine.ToggleHold(dieId);
        RefreshAll(true);
        await PersistAsync();
    }

    private async Task UndoAsync()
    {
        if (_isGameStarted && _engine.Undo())
        {
            _noticeText = string.Empty;
            await RefreshOddsAfterRenderAsync();
            await PersistAsync();
        }
    }

    private async Task ApplyScoreAsync(int gameIndex, ScoreCategory category)
    {
        if (!_isGameStarted)
        {
            return;
        }

        switch (GetPickStatus(gameIndex, category))
        {
            case PickStatus.Valid:
                await FinishScoreAsync(_engine.TryApplyScore(gameIndex, category, _currentPenColorHex));
                break;

            case PickStatus.Scratch:
                _confirm = new ConfirmRequest(
                    "Record a zero?",
                    $"{ScoreRules.GetDisplayName(category)} in Game {gameIndex + 1} does not score with these dice. Mark it with an X (0 points)?",
                    "Mark X",
                    async () => await FinishScoreAsync(_engine.TryScratch(gameIndex, category, _currentPenColorHex)));
                break;

            default:
                _noticeText = _engine.RollCount <= 0
                    ? "Roll at least once before selecting a score cell."
                    : "That cell cannot be used for this roll.";
                break;
        }
    }

    private async Task FinishScoreAsync(ScoreResult result)
    {
        if (!result.Applied)
        {
            return;
        }

        _noticeText = result.YahtzeeBonusAwarded ? "Yahtzee bonus! +100" : string.Empty;
        RefreshAll(false);
        await PersistAsync();

        if (result.WasYahtzee)
        {
            OpenColorPicker("Yahtzee! Pick a pen color", true);
        }
    }

    private PickStatus GetPickStatus(int gameIndex, ScoreCategory category)
    {
        return _isGameStarted ? _engine.GetPickStatus(gameIndex, category) : PickStatus.Unavailable;
    }

    // Shows the dice first, then fills in the odds so a slow device still feels responsive.
    private async Task RefreshOddsAfterRenderAsync()
    {
        RefreshAll(false);
        StateHasChanged();
        await Task.Delay(1);
        RefreshAll(true);
    }

    private void RefreshAll(bool recalculateProbabilities)
    {
        if (_isGameStarted && recalculateProbabilities && _engine.RollCount > 0)
        {
            _probabilities = _engine.CalculateProbabilities();
        }
        else
        {
            _probabilities = ScoreRules.ScoringCategories.ToDictionary(c => c, _ => 0d);
        }
    }

    private string GetStatusText()
    {
        if (!_isGameStarted)
        {
            return "Tap New Game to choose Single or Full Sheet.";
        }

        if (_engine.IsGameComplete)
        {
            return "Game complete. Tap New Game to play again.";
        }

        string modeText = _engine.Mode == GameMode.FullSheet ? "Full Sheet" : "Single";
        if (_engine.RollCount > 0 && _engine.IsJokerRoll)
        {
            return $"{modeText}: Joker! Use the matching upper box, or any open lower box at full value";
        }

        return _engine.RollCount switch
        {
            0 => $"{modeText}: Roll to start your turn",
            _ when _engine.AwaitingScoreSelection => "Roll 3 reached: pick a cell to score",
            _ => $"{modeText}: Roll {_engine.RollCount} of {YahtzeeGameEngine.RollsPerTurn}. Score a valid cell to end early or roll again"
        };
    }

    private string GetDieVisualText(DieState die)
    {
        if (_isRollPressVisual && !die.IsHeld)
        {
            return string.Empty;
        }

        return die.Value <= 0 ? string.Empty : ToDieGlyph(die.Value);
    }

    private string GetDieVisualClass(DieState die)
    {
        if (_isRollPressVisual && !die.IsHeld)
        {
            return "rolling";
        }

        return die.IsHeld ? "held" : string.Empty;
    }

    private static string ToDieGlyph(int value)
    {
        return value switch
        {
            1 => "⚀",
            2 => "⚁",
            3 => "⚂",
            4 => "⚃",
            5 => "⚄",
            6 => "⚅",
            _ => string.Empty
        };
    }

    private string GetColumnClass(int gameIndex)
    {
        return _engine.IsCardEnabled(gameIndex) ? string.Empty : "col-off";
    }

    private string GetBonusMarks(int gameIndex)
    {
        return new string('✓', _engine.Cards[gameIndex].YahtzeeBonusCount);
    }

    private string GetProbabilityText(ScoreCategory category)
    {
        return _engine.RollCount > 0 && _probabilities.TryGetValue(category, out var p)
            ? p.ToString("P1")
            : string.Empty;
    }

    private string GetUpperPaceText(int gameIndex)
    {
        int net = ScoreRules.UpperCategories.Sum(c => ScoreRules.GetUpperPaceDelta(_engine.Cards[gameIndex], c));
        string sign = net > 0 ? "+" : string.Empty;
        return _engine.IsCardEnabled(gameIndex) ? $"{sign}{net}" : "--";
    }

    private string GetPaceToneClass(int gameIndex)
    {
        if (!_engine.IsCardEnabled(gameIndex))
        {
            return "pace-neutral";
        }

        int net = ScoreRules.UpperCategories.Sum(c => ScoreRules.GetUpperPaceDelta(_engine.Cards[gameIndex], c));
        if (net > 0)
        {
            return "pace-up";
        }

        if (net < 0)
        {
            return "pace-down";
        }

        return "pace-neutral";
    }

    private string GetCardTotalDisplay()
    {
        bool showCardTotal = _engine.Mode == GameMode.Single
            ? _engine.Cards[0].IsComplete
            : _engine.Cards.All(c => c.IsComplete);

        if (!showCardTotal)
        {
            return "--";
        }

        int cardTotal = _engine.Cards.Sum(c => c.GameTotal ?? 0);
        return cardTotal.ToString();
    }

    private static string GetScoreClass(ScoreCellState cell, PickStatus status)
    {
        if (cell.IsFilled)
        {
            return "filled";
        }

        return status switch
        {
            PickStatus.Valid => "valid",
            PickStatus.Scratch => "scratch",
            _ => "empty"
        };
    }

    private static string GetScoreButtonStyle(ScoreCellState cell, bool enabled)
    {
        if (cell.IsFilled)
        {
            string textColor = GetContrastingTextColor(cell.PenColorHex);
            string border = enabled ? "#1F2937" : "#374151";
            return $"background:{cell.PenColorHex};color:{textColor};border-color:{border};";
        }

        return string.Empty;
    }

    private static string GetContrastingTextColor(string backgroundHex)
    {
        if (!TryParseHexColor(backgroundHex, out int r, out int g, out int b))
        {
            return "#FFFFFF";
        }

        double luminance = (0.299 * r) + (0.587 * g) + (0.114 * b);
        return luminance > 145 ? "#111827" : "#FFFFFF";
    }

    private static bool TryParseHexColor(string hex, out int r, out int g, out int b)
    {
        r = g = b = 0;
        if (string.IsNullOrWhiteSpace(hex))
        {
            return false;
        }

        string cleaned = hex.TrimStart('#');
        if (cleaned.Length != 6)
        {
            return false;
        }

        return int.TryParse(cleaned.AsSpan(0, 2), System.Globalization.NumberStyles.HexNumber, null, out r)
            && int.TryParse(cleaned.AsSpan(2, 2), System.Globalization.NumberStyles.HexNumber, null, out g)
            && int.TryParse(cleaned.AsSpan(4, 2), System.Globalization.NumberStyles.HexNumber, null, out b);
    }
}

