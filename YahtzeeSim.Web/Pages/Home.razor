@page "/"
@inject IJSRuntime JS
@inject AccountService Account
@inject ScoreQueue Queue
@inject ActionLog Actions

<PageTitle>YahtzeeSim</PageTitle>

<div class="sr-only" role="status" aria-live="polite" aria-atomic="true">@_announcement</div>

<div class="game-page" inert="@HasOpenDialog">
  <header class="topbar">
    <h1 class="brand">
        <span class="brand-mark" aria-hidden="true">&#9860;</span>
        <span class="brand-name">Yahtzee<span>Sim</span></span>
    </h1>
    <button type="button" class="dock-btn dock-side" aria-label="@DockSideLabel" title="@DockSideLabel" @onclick="ToggleDiceSideAsync">
        <svg viewBox="0 0 20 16" width="22" height="18" aria-hidden="true" focusable="false">
            <rect x="1" y="1" width="18" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6" />
            <rect x="@(_diceSide == "left" ? 2.5 : 11.5)" y="2.5" width="6" height="11" rx="1.2" fill="currentColor" />
        </svg>
        <span>Dice @(_diceSide == "left" ? "left" : "right")</span>
    </button>
    <button type="button" class="dock-btn dock-edge" aria-label="@DockEdgeLabel" title="@DockEdgeLabel" @onclick="ToggleDiceEdgeAsync">
        <svg viewBox="0 0 20 16" width="22" height="18" aria-hidden="true" focusable="false">
            <rect x="1" y="1" width="18" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6" />
            <rect x="2.5" y="@(_diceEdge == "top" ? 2.5 : 9)" width="15" height="4.5" rx="1.2" fill="currentColor" />
        </svg>
    </button>
    <button type="button" class="dock-btn account-btn" aria-label="Leaderboard" title="Leaderboard" @onclick="OpenLeaderboard">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M7 3h10v2h3v3c0 2.2-1.8 4-4 4h-.3A5 5 0 0 1 13 14.9V17h3v2H8v-2h3v-2.1A5 5 0 0 1 8.3 12H8C5.8 12 4 10.2 4 8V5h3V3zm-1 4v1c0 1.1.9 2 2 2V7H6zm12 0h-2v3c1.1 0 2-.9 2-2V7z" />
        </svg>
    </button>
    <button type="button" class="dock-btn account-btn" aria-label="@AccountLabel" title="@AccountLabel" @onclick="OpenAccountAsync">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9zm0 2c-4 0-8 2-8 5v2h16v-2c0-3-4-5-8-5z" />
        </svg>
    </button>
    <button type="button" class="new-game" @onclick="StartGameButtonClicked">New Game</button>
  </header>
  <div class="content">
  <div class="play-layout dice-@_diceSide dice-@_diceEdge">
   <div class="play-panel turn-card">
    <div class="turn-overline">
        <span class="turn-mode">@(_isGameStarted ? ModeLabel : "New game")</span>
        <span class="turn-side">
            <button type="button" class="undo" disabled="@(!_isGameStarted || !_engine.CanUndo)" @onclick="UndoAsync"><span aria-hidden="true">&#8630; </span>Undo</button>
            @if (TurnNumber is int turn)
            {
                <span class="round-pill">Turn @turn</span>
            }
        </span>
    </div>
    <p class="turn-title">@Status.Headline</p>
    <p class="turn-hint">@Status.Detail</p>

    @if (!string.IsNullOrWhiteSpace(_noticeText))
    {
        <div class="notice">@_noticeText</div>
    }

    <div class="roll-progress" aria-hidden="true">
        @for (int i = 0; i < YahtzeeGameEngine.RollsPerTurn; i++)
        {
            <span class="@(_isGameStarted && i < _engine.RollCount ? "done" : string.Empty)"></span>
        }
    </div>

    @if (_engine.Mode == GameMode.FullSheet && _engine.Cards.All(c => c.IsComplete))
    {
        <section class="summary-panel" aria-labelledby="summary-title">
            <h2 id="summary-title">Full Sheet Complete</h2>
            <div class="summary-text">
                @for (int gameIndex = 0; gameIndex < YahtzeeGameEngine.GameCount; gameIndex++)
                {
                    var card = _engine.Cards[gameIndex];
                    <div>Game @(gameIndex + 1): Upper @(card.UpperSubtotal ?? 0), Lower @(card.LowerSubtotal ?? 0), Bonus @(card.UpperBonus ?? 0), Total @(card.GameTotal ?? 0)</div>
                }
                <div class="series-total">Series total: @(_engine.Cards.Sum(c => c.GameTotal ?? 0))</div>
            </div>
        </section>
    }
    else
    {
    <section class="dice-row" aria-label="Dice">
        @foreach (var (die, index) in _engine.Dice.Select((d, i) => (d, i)))
        {
            bool canHold = _isGameStarted && _engine.RollCount > 0 && !_engine.AwaitingScoreSelection;
            bool shownHeld = IsShownHeld(die);
            <button
                type="button"
                class="die @GetDieVisualClass(die)"
                disabled="@(!canHold)"
                aria-pressed="@(shownHeld ? "true" : "false")"
                aria-label="@GetDieLabel(die, index)"
                @onclick="() => ToggleHoldAsync(die.Id)">
                <span class="die-face" aria-hidden="true">
                    @foreach (bool lit in GetDiePips(die))
                    {
                        <i class="@(lit ? "pip" : null)"></i>
                    }
                </span>
                @if (shownHeld)
                {
                    <span class="die-tag" aria-hidden="true">Held</span>
                }
            </button>
        }
    </section>
    }

    <section class="action-row" aria-label="Turn controls">
        <button
            type="button"
            class="roll"
            disabled="@(!_isGameStarted || !_engine.CanRoll)"
            @onpointerdown="RollButtonPressed"
            @onpointerup="RollButtonReleased"
            @onpointerleave="RollButtonReleased"
            @onpointercancel="RollButtonReleased"
            @onclick="RollButtonClickedAsync">
            <span>Roll</span>
            <span class="keycap" aria-hidden="true">@(_isGameStarted ? _engine.RollCount : 0)/@YahtzeeGameEngine.RollsPerTurn</span>
        </button>
    </section>
   </div>
   <div class="card-panel">
    <section class="score-wrap sheet-card">
        <div class="sheet-head">
            <h2 class="sheet-heading">Scorecard<span> &middot; @(_engine.Mode == GameMode.Single ? "one game" : "six games")</span></h2>
        </div>
        <div class="score-scroll">
        <table class="score-grid" role="table" aria-label="Score card for six games. Choose one open cell to score this turn.">
            <colgroup>
                <col class="col-category" />
                <col class="col-prob" />
                <col class="col-game" />
                <col class="col-game" />
                <col class="col-game" />
                <col class="col-game" />
                <col class="col-game" />
                <col class="col-game" />
            </colgroup>
            <thead role="rowgroup">
                <tr role="row">
                    <th role="columnheader" scope="col" class="cat-head">Category</th>
                    <th role="columnheader" scope="col" class="odds-head">Odds</th>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <th role="columnheader" scope="col" class="@GetColumnClass(game)">G@(game + 1)</th>
                    }
                </tr>
            </thead>
            <tbody role="rowgroup">
                <tr role="row" class="pace-row">
                    <td role="rowheader" class="row-label">Upper Pace</td>
                    <td role="cell" class="odds-col"><span class="pace-note">vs 3 of each</span></td>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td role="cell" class="game-cell pace-tone @GetPaceToneClass(game) @GetColumnClass(game)">@GetUpperPaceText(game)</td>
                    }
                </tr>

                <tr role="row" class="section-row"><td role="cell" colspan="8">Upper Section</td></tr>
                @foreach (var category in ScoreRules.UpperCategories)
                {
                    @ScoreRow(category)
                }

                <tr role="row" class="totals-row">
                    <td role="rowheader" class="row-label">Upper Total</td>
                    <td role="cell" class="odds-col"></td>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td role="cell" class="game-cell @GetColumnClass(game)">@(_engine.Cards[game].UpperSubtotal?.ToString() ?? "--")</td>
                    }
                </tr>

                <tr role="row" class="totals-row">
                    <td role="rowheader" class="row-label">Bonus <span class="hint">35 if 63+</span></td>
                    <td role="cell" class="odds-col"></td>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td role="cell" class="game-cell @GetColumnClass(game)">@(_engine.Cards[game].UpperBonus?.ToString() ?? "--")</td>
                    }
                </tr>

                <tr role="row" class="section-row"><td role="cell" colspan="8">Lower Section</td></tr>
                @foreach (var category in ScoreRules.LowerCategories)
                {
                    @ScoreRow(category)
                }

                <tr role="row" class="yahtzee-bonus-row">
                    <td role="rowheader" class="row-label">Yahtzee Bonus <span class="hint">100 each</span></td>
                    <td role="cell" class="odds-col"></td>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td role="cell" class="game-cell bonus-marks @GetColumnClass(game)" aria-label="@GetBonusLabel(game)">@GetBonusMarks(game)</td>
                    }
                </tr>

                <tr role="row" class="totals-row">
                    <td role="rowheader" class="row-label">Lower Total</td>
                    <td role="cell" class="odds-col"></td>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td role="cell" class="game-cell @GetColumnClass(game)">@(_engine.Cards[game].LowerSubtotal?.ToString() ?? "--")</td>
                    }
                </tr>

                <tr role="row" class="totals-row grand-row">
                    <td role="rowheader" class="row-label">Game Total</td>
                    <td role="cell" class="odds-col"></td>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td role="cell" class="game-cell @GetColumnClass(game)">@(_engine.Cards[game].GameTotal?.ToString() ?? "--")</td>
                    }
                </tr>

                <tr role="row" class="totals-row card-total-row">
                    <td role="rowheader" class="row-label">Card Total</td>
                    <td role="cell" class="odds-col"></td>
                    <td role="cell" class="game-cell card-total-value">@GetCardTotalDisplay()</td>
                    @for (int game = 1; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td role="cell" class="game-cell filler"></td>
                    }
                </tr>
            </tbody>
        </table>
        </div>
    </section>
   </div>
  </div>

  </div>
</div>

@code {
    private RenderFragment ScoreRow(ScoreCategory category) => __builder =>
    {
        <tr role="row" class="score-row">
            <td role="rowheader" class="row-label">@ScoreRules.GetDisplayName(category)</td>
            <td role="cell" class="odds-col prob-cell">@GetProbabilityCell(category)</td>
            @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
            {
                var gameIndex = game;
                var cell = _engine.Cards[game].Scores[category];
                var status = GetPickStatus(gameIndex, category);
                bool enabled = status != PickStatus.Unavailable;
                <td role="cell" class="game-cell @GetColumnClass(game)">
                    <button
                        type="button"
                        class="score-btn @GetScoreClass(cell, status)"
                        style="@GetScoreButtonStyle(cell, enabled)"
                        disabled="@(!enabled)"
                        aria-label="@GetScoreLabel(gameIndex, category, cell, status)"
                        @onclick="() => ApplyScoreAsync(gameIndex, category)">
                        @cell.DisplayText
                    </button>
                </td>
            }
        </tr>
    };

    private RenderFragment GetProbabilityCell(ScoreCategory category) => __builder =>
    {
        string text = GetProbabilityText(category);
        if (text.Length > 0)
        {
            <span class="odds-label">Odds </span>@text
        }
    };
}

@if (_showResumePrompt)
{
    <div class="overlay">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="resume-title" tabindex="-1" @ref="_dialogRef">
            <h3 id="resume-title">Resume your game?</h3>
            <p class="modal-text">A game in progress was saved on this device.</p>
            <div class="modal-actions">
                <button type="button" @onclick="ResumeSavedGameAsync">Resume</button>
                <button type="button" class="secondary" @onclick="DiscardSavedGameAsync">Discard</button>
            </div>
        </div>
    </div>
}

@if (_confirm != null)
{
    <div class="overlay" @onkeydown="OnConfirmKeyDown">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="confirm-title" tabindex="-1" @ref="_dialogRef">
            <h3 id="confirm-title">@_confirm.Title</h3>
            <p class="modal-text">@_confirm.Message</p>
            <div class="modal-actions">
                <button type="button" @onclick="AcceptConfirmAsync">@_confirm.AcceptText</button>
                <button type="button" class="secondary" @onclick="CancelConfirm">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_showModePicker)
{
    <div class="overlay" @onkeydown="OnModePickerKeyDown">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="mode-title" tabindex="-1" @ref="_dialogRef">
            <h3 id="mode-title">Choose Game Mode</h3>
            <div class="modal-actions mode-actions">
                <button type="button" @onclick="() => SelectGameModeAsync(GameMode.Single)">Single</button>
                <button type="button" @onclick="() => SelectGameModeAsync(GameMode.FullSheet)">Full Sheet</button>
                <button type="button" class="secondary" @onclick="CancelGameMode">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_showColorPicker)
{
    <div class="overlay" @onkeydown="OnColorPickerKeyDown">
        <div class="modal color-modal" role="dialog" aria-modal="true" aria-labelledby="color-title" tabindex="-1" @ref="_dialogRef">
            <h3 id="color-title">@_colorPickerTitle</h3>
            <div class="wheel-wrap">
                <div class="color-wheel"
                     tabindex="0"
                     role="group"
                     @onpointerdown="WheelPointer"
                     @onpointermove="WheelPointer"
                     @onkeydown="WheelKeyDown"
                     aria-label="Colour wheel, @PickedHex. Left and right arrows change the colour, up and down change the strength.">
                    <div class="wheel-marker" style="left:@(MarkerLeft());top:@(MarkerTop());background:@PickedHex"></div>
                </div>
            </div>
            <label class="light-row">
                <span>Dark</span>
                <input type="range" class="light-slider" min="15" max="85" value="@((int)Math.Round(_pickLightness * 100))"
                       style="--hue:@((int)_pickHue);--sat:@Percent(_pickSaturation)"
                       @oninput="LightnessChanged" aria-label="Lightness" />
                <span>Light</span>
            </label>
            <div class="pick-preview">
                <span class="pick-chip" style="background:@PickedHex"></span>
                <span>@PickedHex</span>
            </div>
            <div class="modal-actions">
                <button type="button" @onclick="() => PickPenColorAsync(PickedHex)">Use this color</button>
                @if (_allowKeepCurrentColor)
                {
                    <button type="button" class="secondary" @onclick="KeepCurrentColor">Keep Current</button>
                }
            </div>
        </div>
    </div>
}

@if (_showLeaderboard)
{
    <div class="overlay" @onkeydown="OnLeaderboardKeyDown">
        <div class="modal leaderboard-modal" role="dialog" aria-modal="true" aria-labelledby="lb-title" tabindex="-1" @ref="_dialogRef">
            <LeaderboardView OnClose="CloseLeaderboard" />
        </div>
    </div>
}

@if (_showAccount)
{
    <div class="overlay" @onkeydown="OnAccountKeyDown">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="account-title" tabindex="-1" @ref="_dialogRef">
            <h3 id="account-title">Account</h3>
            <p class="modal-text">Signed in as <strong>@Account.Nickname</strong>@(Account.IsOffline ? " (offline)" : null)</p>
            @if (_editingNickname)
            {
                <form class="nick-form" @onsubmit="SaveNicknameAsync">
                    <label for="nick-edit">New nickname</label>
                    <input id="nick-edit" type="text" maxlength="16" autocomplete="off" autocapitalize="off" spellcheck="false"
                           aria-describedby="nick-edit-help nick-edit-error" aria-invalid="@(_nicknameError != null ? "true" : "false")"
                           @bind="_nicknameInput" @bind:event="oninput" @onkeydown="OnNicknameKeyDown" @ref="_nicknameRef" />
                    <p id="nick-edit-help" class="nick-help">3 to 16 letters, numbers, spaces, _ or -. It shows on the leaderboard next to all your scores.</p>
                    <p id="nick-edit-error" class="nick-error" role="alert">@_nicknameError</p>
                    <div class="modal-actions">
                        <button type="submit" disabled="@_nicknameSaving">Save</button>
                        <button type="button" class="secondary" @onclick="CancelNicknameEdit">Cancel</button>
                    </div>
                </form>
            }
            else
            {
                @if (!string.IsNullOrEmpty(_nicknameNotice))
                {
                    <p class="modal-text nick-notice" role="status">@_nicknameNotice</p>
                }
            }
            @if (_pendingScores > 0)
            {
                <p class="modal-text">@_pendingScores finished @(_pendingScores == 1 ? "game is" : "games are") waiting to upload. @(_pendingScores == 1 ? "It" : "They") will upload when you sign in as @Account.Nickname again with a connection.</p>
            }
            <p class="modal-text"><a href="privacy" target="_blank" rel="noopener">Privacy</a></p>
            @if (!_editingNickname)
            {
                <div class="modal-actions">
                    <button type="button" @onclick="StartNicknameEdit">Change nickname</button>
                    <button type="button" @onclick="SignOutAsync">Sign out</button>
                    <button type="button" class="secondary" @onclick="CloseAccount">Close</button>
                </div>
            }
        </div>
    </div>
}

@if (_showYahtzeeSplash)
{
    <div class="overlay yahtzee-splash" @onclick="DismissSplash" role="alert">
        <div class="splash-text">YAHTZEE!</div>
    </div>
}

@code {
    private sealed record ConfirmRequest(string Title, string Message, string AcceptText, Func<Task> OnAccept);

    private const string SaveKey = "yahtzeesim.save";
    private const string PenKey = "yahtzeesim.pen";
    private const string DiceSideKey = "yahtzeesim.diceSide";
    private const string DiceEdgeKey = "yahtzeesim.diceEdge";
    private const int SplashMilliseconds = 2000;

    private readonly YahtzeeGameEngine _engine = new();
    private Dictionary<ScoreCategory, double> _probabilities = new();
    private string _currentPenColorHex = "#1D2939";
    // Landscape puts the dice beside the scorecard (left or right); portrait puts them above or below it.
    private string _diceSide = "right";
    private string _diceEdge = "bottom";
    private bool _isGameStarted;
    private bool _isRollPressVisual;
    private string _noticeText = string.Empty;
    private string _announcement = string.Empty;
    private ElementReference _dialogRef;
    private string? _focusedDialog;

    private bool _showModePicker;
    private bool _showColorPicker;
    private bool _allowKeepCurrentColor;
    private string _colorPickerTitle = "Pick Pen Color";
    private bool _showResumePrompt;
    private bool _showLeaderboard;
    private bool _showAccount;
    private bool _editingNickname;
    private bool _focusNicknameInput;
    private bool _nicknameSaving;
    private string _nicknameInput = string.Empty;
    private string? _nicknameError;
    private string? _nicknameNotice;
    private ElementReference _nicknameRef;
    private int _pendingScores;
    private string? _pendingSaveJson;
    private ConfirmRequest? _confirm;
    private bool _showYahtzeeSplash;
    private int _splashToken;

    private const double WheelSize = 240;
    private double _pickHue;
    private double _pickSaturation = 1;
    private double _pickLightness = 0.5;

    private string PickedHex => HslToHex(_pickHue, _pickSaturation, _pickLightness);

    protected override void OnInitialized()
    {
        _engine.Reset(GameMode.Single);
        RefreshAll(false);
    }

    // Topmost dialog first; matches the order the overlays are rendered in.
    private string? ActiveDialog => _showColorPicker ? "color"
        : _showModePicker ? "mode"
        : _confirm != null ? "confirm"
        : _showLeaderboard ? "leaderboard"
        : _showAccount ? "account"
        : _showResumePrompt ? "resume"
        : null;

    private string AccountLabel => $"Account: {Account.Nickname}";

    private void OpenLeaderboard() => _showLeaderboard = true;

    private void CloseLeaderboard() => _showLeaderboard = false;

    private void OnLeaderboardKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseLeaderboard();
        }
    }

    private async Task OpenAccountAsync()
    {
        _pendingScores = await Queue.CountForCurrentUserAsync();
        _showAccount = true;
    }

    private void CloseAccount()
    {
        _showAccount = false;
        _editingNickname = false;
        _nicknameNotice = null;
    }

    private void OnAccountKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            if (_editingNickname)
            {
                CancelNicknameEdit();
            }
            else
            {
                CloseAccount();
            }
        }
    }

    private void StartNicknameEdit()
    {
        _nicknameInput = Account.Nickname ?? string.Empty;
        _nicknameError = null;
        _nicknameNotice = null;
        _editingNickname = true;
        _focusNicknameInput = true;
    }

    private void CancelNicknameEdit()
    {
        _editingNickname = false;
        _nicknameError = null;
    }

    private void OnNicknameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CancelNicknameEdit();
        }
    }

    private async Task SaveNicknameAsync()
    {
        string nickname = _nicknameInput.Trim();
        if (string.Equals(nickname, Account.Nickname, StringComparison.Ordinal))
        {
            CancelNicknameEdit();
            return;
        }

        if (!AccountService.IsValidNickname(nickname))
        {
            _nicknameError = "Use 3 to 16 letters, numbers, spaces, _ or -, starting and ending with a letter or number.";
            return;
        }

        _nicknameSaving = true;
        _nicknameError = null;
        var result = await Account.SetNicknameAsync(nickname);
        _nicknameSaving = false;
        _nicknameError = result switch
        {
            NicknameResult.Taken => "That nickname is taken. Try another.",
            NicknameResult.Invalid => "That nickname is not allowed. Try another.",
            NicknameResult.Failed => "Could not save. Check your connection and try again.",
            _ => null
        };

        if (result == NicknameResult.Saved)
        {
            _editingNickname = false;
            _nicknameNotice = "Nickname updated.";
        }
    }

    private async Task SignOutAsync()
    {
        CloseAccount();
        await Account.SignOutAsync();
    }

    // Uploads a finished game, or leaves it queued (offline, or the server is unavailable) to retry later.
    private async Task SubmitFinishedGameAsync()
    {
        if (_engine.FinalScore is not int total)
        {
            return;
        }

        bool uploaded = await Queue.SubmitAsync(_engine.GameId, _engine.Mode, total);
        string message = uploaded
            ? "Score added to the leaderboard."
            : "Score saved. It will upload when you are back online.";
        _noticeText = message;
        _announcement += " " + message;
    }

    private bool HasOpenDialog => ActiveDialog != null;

    private int? TurnNumber => _isGameStarted ? _engine.TurnNumber : null;

    private string ModeLabel => _engine.Mode == GameMode.FullSheet ? "Full Sheet" : "Single";

    private (string Headline, string Detail) Status => GetStatus();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        string? dialog = ActiveDialog;
        if (_focusNicknameInput)
        {
            _focusNicknameInput = false;
            try
            {
                await _nicknameRef.FocusAsync();
            }
            catch (Exception ex) when (ex is InvalidOperationException or JSException)
            {
                // Focus is a convenience; the field still works without it.
            }
        }

        if (dialog != _focusedDialog)
        {
            _focusedDialog = dialog;
            if (dialog != null)
            {
                try
                {
                    await _dialogRef.FocusAsync();
                }
                catch (Exception ex) when (ex is InvalidOperationException or JSException)
                {
                    // Focus is a convenience; the dialog still works without it.
                }
            }
        }

        if (!firstRender)
        {
            return;
        }

        try
        {
            string? pen = await JS.InvokeAsync<string?>("localStorage.getItem", PenKey);
            if (!string.IsNullOrWhiteSpace(pen) && TryParseHexColor(pen, out _, out _, out _))
            {
                _currentPenColorHex = pen;
            }

            string? side = await JS.InvokeAsync<string?>("localStorage.getItem", DiceSideKey);
            string? edge = await JS.InvokeAsync<string?>("localStorage.getItem", DiceEdgeKey);
            if (side is "left" or "right")
            {
                _diceSide = side;
            }

            if (edge is "top" or "bottom")
            {
                _diceEdge = edge;
            }

            StateHasChanged();

            string? saved = await JS.InvokeAsync<string?>("localStorage.getItem", SaveKey);
            if (!string.IsNullOrWhiteSpace(saved))
            {
                if (new YahtzeeGameEngine().TryLoad(saved))
                {
                    _pendingSaveJson = saved;
                    _showResumePrompt = true;
                    StateHasChanged();
                }
                else
                {
                    await RemoveStorageAsync(SaveKey);
                }
            }
        }
        catch (JSException)
        {
            // Storage can be unavailable (private mode); the game still works without saving.
        }
    }

    private bool HasProgress => _isGameStarted
        && !_engine.IsGameComplete
        && (_engine.RollCount > 0 || _engine.Cards.Any(c => c.Scores.Values.Any(s => s.IsFilled)));

    private async Task PersistAsync()
    {
        try
        {
            if (HasProgress)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", SaveKey, _engine.Serialize());
            }
            else
            {
                await RemoveStorageAsync(SaveKey);
            }
        }
        catch (JSException)
        {
            // Saving is best effort.
        }
    }

    private string DockSideLabel => $"Dice are on the {_diceSide}. Move dice to the {(_diceSide == "left" ? "right" : "left")}.";

    private string DockEdgeLabel => $"Dice are at the {_diceEdge}. Move dice to the {(_diceEdge == "top" ? "bottom" : "top")}.";

    private async Task ToggleDiceSideAsync()
    {
        _diceSide = _diceSide == "left" ? "right" : "left";
        _announcement = $"Dice moved to the {_diceSide}.";
        await SetPreferenceAsync(DiceSideKey, _diceSide);
    }

    private async Task ToggleDiceEdgeAsync()
