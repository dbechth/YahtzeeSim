@page "/"

<PageTitle>YahtzeeSim</PageTitle>

<div class="maui-page">
    <section class="top-bar">
        <h1>Yahtzee</h1>
        <div class="status">@GetStatusText()</div>
        <button class="new-game" @onclick="StartGameButtonClicked">New Game</button>
    </section>

    @if (!string.IsNullOrWhiteSpace(_noticeText))
    {
        <div class="notice">@_noticeText</div>
    }

    <section class="dice-row">
        @foreach (var die in _engine.Dice)
        {
            bool canHold = _isGameStarted && _engine.RollCount > 0 && !_engine.AwaitingScoreSelection;
            <button
                class="die @GetDieVisualClass(die)"
                disabled="@(!canHold)"
                @onclick="() => ToggleHold(die.Id)">
                @GetDieVisualText(die)
            </button>
        }
    </section>

    <section class="action-row">
        <button
            class="roll"
            disabled="@(!_isGameStarted || !_engine.CanRoll)"
            @onpointerdown="RollButtonPressed"
            @onpointerup="RollButtonReleased"
            @onpointerleave="RollButtonReleased"
            @onpointercancel="RollButtonReleased"
            @onclick="RollButtonClickedAsync">Roll</button>
        <button class="undo" disabled="@(!_isGameStarted || !_engine.CanUndo)" @onclick="Undo">Undo</button>
    </section>

    <section class="score-wrap">
        <table class="score-grid" aria-label="Yahtzee Score Grid">
            <colgroup>
                <col class="col-category" />
                <col class="col-prob" />
                <col class="col-game" />
                <col class="col-game" />
                <col class="col-game" />
                <col class="col-game" />
                <col class="col-game" />
                <col class="col-game" />
            </colgroup>
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Prob</th>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <th>G@(game + 1)</th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr class="pace-row">
                    <td>Upper Pace</td>
                    <td>vs 3x target</td>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td class="pace-tone @GetPaceToneClass(game)">@GetUpperPaceText(game)</td>
                    }
                </tr>

                @foreach (var category in ScoreRules.ScoringCategories)
                {
                    <tr>
                        <td class="category-cell">@ScoreRules.GetDisplayName(category)</td>
                        <td class="prob-cell">@GetProbabilityText(category)</td>
                        @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                        {
                            var cell = _engine.Cards[game].Scores[category];
                            bool enabled = CanAttemptScore(game, cell);
                            bool isValid = IsCategoryCurrentlyValid(category, game);
                            <td>
                                <button
                                    class="score-btn @GetScoreClass(cell, isValid)"
                                    style="@GetScoreButtonStyle(cell, enabled)"
                                    disabled="@(!enabled)"
                                    @onclick="() => ApplyScoreAsync(game, category)">
                                    @cell.DisplayText
                                </button>
                            </td>
                        }
                    </tr>

                    @if (category == ScoreRules.UpperCategories.Last())
                    {
                        <tr class="separator-row"><td colspan="8"></td></tr>
                    }
                }

                <tr class="totals-row">
                    <td>Upper</td>
                    <td></td>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td>@(_engine.Cards[game].UpperSubtotal?.ToString() ?? "--")</td>
                    }
                </tr>

                <tr class="totals-row">
                    <td>Lower</td>
                    <td></td>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td>@(_engine.Cards[game].LowerSubtotal?.ToString() ?? "--")</td>
                    }
                </tr>

                <tr class="totals-row">
                    <td>Bonus</td>
                    <td></td>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td>@(_engine.Cards[game].UpperBonus?.ToString() ?? "--")</td>
                    }
                </tr>

                <tr class="totals-row">
                    <td>Game Total</td>
                    <td></td>
                    @for (int game = 0; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td>@(_engine.Cards[game].GameTotal?.ToString() ?? "--")</td>
                    }
                </tr>

                <tr class="totals-row card-total-row">
                    <td>Card Total</td>
                    <td></td>
                    <td>@GetCardTotalDisplay()</td>
                    @for (int game = 1; game < YahtzeeGameEngine.GameCount; game++)
                    {
                        <td></td>
                    }
                </tr>
            </tbody>
        </table>
    </section>

    @if (_engine.Mode == GameMode.FullSheet && _engine.Cards.All(c => c.IsComplete))
    {
        <section class="summary-panel">
            <h2>Full Sheet Complete</h2>
            <div class="summary-text">
                @for (int gameIndex = 0; gameIndex < YahtzeeGameEngine.GameCount; gameIndex++)
                {
                    var card = _engine.Cards[gameIndex];
                    <div>Game @(gameIndex + 1): U @(card.UpperSubtotal ?? 0), L @(card.LowerSubtotal ?? 0), B @(card.UpperBonus ?? 0), T @(card.GameTotal ?? 0)</div>
                }
                <div>Series Card Total: @(_engine.Cards.Sum(c => c.GameTotal ?? 0))</div>
            </div>
        </section>
    }
</div>

@if (_showModePicker)
{
    <div class="overlay">
        <div class="modal">
            <h3>Choose Game Mode</h3>
            <div class="modal-actions mode-actions">
                <button @onclick="() => SelectGameMode(GameMode.Single)">Single</button>
                <button @onclick="() => SelectGameMode(GameMode.FullSheet)">Full Sheet</button>
                <button class="secondary" @onclick="CancelGameMode">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_showColorPicker)
{
    <div class="overlay">
        <div class="modal color-modal">
            <h3>@_colorPickerTitle</h3>
            <div class="swatch-grid">
                @foreach (var hex in PenColors)
                {
                    <button class="swatch" style="background-color:@hex" @onclick="() => PickPenColor(hex)" aria-label="Select @hex"></button>
                }
            </div>
            @if (_allowKeepCurrentColor)
            {
                <div class="modal-actions">
                    <button class="secondary" @onclick="KeepCurrentColor">Keep Current</button>
                </div>
            }
        </div>
    </div>
}

@code {
    private readonly YahtzeeGameEngine _engine = new();
    private Dictionary<ScoreCategory, double> _probabilities = new();
    private string _currentPenColorHex = "#1D2939";
    private bool _isGameStarted;
    private bool _isRollPressVisual;
    private string _noticeText = string.Empty;

    private bool _showModePicker;
    private bool _showColorPicker;
    private bool _allowKeepCurrentColor;
    private string _colorPickerTitle = "Pick Pen Color";

    private static readonly string[] PenColors =
    [
        "#7F1D1D", "#B91C1C", "#EF4444", "#FCA5A5",
        "#7C2D12", "#C2410C", "#F97316", "#FDBA74",
        "#854D0E", "#CA8A04", "#FACC15", "#FDE68A",
        "#166534", "#16A34A", "#4ADE80", "#BBF7D0",
        "#1E3A8A", "#2563EB", "#60A5FA", "#BFDBFE",
        "#581C87", "#7E22CE", "#C084FC", "#E9D5FF"
    ];

    protected override void OnInitialized()
    {
        _engine.Reset(GameMode.Single);
        RefreshAll(false);
    }

    private void StartGameButtonClicked()
    {
        _showModePicker = true;
    }

    private void CancelGameMode()
    {
        _showModePicker = false;
    }

    private void SelectGameMode(GameMode mode)
    {
        _showModePicker = false;
        _engine.Reset(mode);
        _isGameStarted = true;
        _noticeText = string.Empty;
        RefreshAll(false);
        OpenColorPicker("Pick Pen Color", false);
    }

    private void OpenColorPicker(string title, bool allowKeepCurrent)
    {
        _colorPickerTitle = title;
        _allowKeepCurrentColor = allowKeepCurrent;
        _showColorPicker = true;
    }

    private void PickPenColor(string hex)
    {
        _currentPenColorHex = hex;
        _showColorPicker = false;
    }

    private void KeepCurrentColor()
    {
        _showColorPicker = false;
    }

    private void RollButtonPressed()
    {
        if (_isGameStarted && _engine.CanRoll)
        {
            _isRollPressVisual = true;
        }
    }

    private void RollButtonReleased()
    {
        _isRollPressVisual = false;
    }

    private Task RollButtonClickedAsync()
    {
        if (!_isGameStarted || !_engine.CanRoll)
        {
            _isRollPressVisual = false;
            return Task.CompletedTask;
        }

        if (_engine.RollDice())
        {
            RefreshAll(true);
        }

        _isRollPressVisual = false;
        return Task.CompletedTask;
    }

    private void ToggleHold(int dieId)
    {
        if (!_isGameStarted)
        {
            return;
        }

        _engine.ToggleHold(dieId);
    }

    private void Undo()
    {
        if (!_isGameStarted)
        {
            return;
        }

        if (_engine.Undo())
        {
            _noticeText = string.Empty;
            RefreshAll(true);
        }
    }

    private Task ApplyScoreAsync(int gameIndex, ScoreCategory category)
    {
        if (!_isGameStarted)
        {
            return Task.CompletedTask;
        }

        if (_engine.RollCount <= 0)
        {
            _noticeText = "Roll at least once before selecting a score cell.";
            return Task.CompletedTask;
        }

        if (_engine.TryApplyScore(gameIndex, category, _currentPenColorHex, out bool wasScratch, out _, out bool wasYahtzee))
        {
            if (wasScratch)
            {
                _noticeText = "That category did not meet minimum rules, so it was recorded as X.";
            }
            else if (wasYahtzee)
            {
                _noticeText = "YAHTZEE rolled. Pick a pen color for your next entry.";
                OpenColorPicker("Pick Pen Color", true);
            }
            else
            {
                _noticeText = string.Empty;
            }

            RefreshAll(true);
        }
        else if (!_engine.AwaitingScoreSelection)
        {
            _noticeText = "That category is not valid yet. Keep rolling or choose a valid category to end early.";
        }

        return Task.CompletedTask;
    }

    private bool CanAttemptScore(int gameIndex, ScoreCellState cell)
    {
        return _isGameStarted
            && _engine.RollCount > 0
            && _engine.IsCardEnabled(gameIndex)
            && !cell.IsFilled;
    }

    private void RefreshAll(bool recalculateProbabilities)
    {
        if (_isGameStarted && recalculateProbabilities && _engine.RollCount > 0)
        {
            _probabilities = _engine.CalculateProbabilities();
        }
        else
        {
            _probabilities = ScoreRules.ScoringCategories.ToDictionary(c => c, _ => 0d);
        }
    }

    private string GetStatusText()
    {
        if (!_isGameStarted)
        {
            return "Tap New Game to choose Single or Full Sheet.";
        }

        string modeText = _engine.Mode == GameMode.FullSheet ? "Full Sheet" : "Single";
        return _engine.RollCount switch
        {
            0 => $"{modeText}: Roll to start your turn",
            _ when _engine.AwaitingScoreSelection => "Roll 3 reached: pick any score cell",
            _ => $"{modeText}: Roll {_engine.RollCount} of {YahtzeeGameEngine.RollsPerTurn}. Pick a valid category to end early or roll again"
        };
    }

    private string GetDieVisualText(DieState die)
    {
        if (_isRollPressVisual && !die.IsHeld)
        {
            return string.Empty;
        }

        return die.Value <= 0 ? string.Empty : ToDieGlyph(die.Value);
    }

    private string GetDieVisualClass(DieState die)
    {
        if (_isRollPressVisual && !die.IsHeld)
        {
            return "rolling";
        }

        return die.IsHeld ? "held" : string.Empty;
    }

    private static string ToDieGlyph(int value)
    {
        return value switch
        {
            1 => "⚀",
            2 => "⚁",
            3 => "⚂",
            4 => "⚃",
            5 => "⚄",
            6 => "⚅",
            _ => string.Empty
        };
    }

    private bool IsCategoryCurrentlyValid(ScoreCategory category, int gameIndex)
    {
        var cell = _engine.Cards[gameIndex].Scores[category];
        if (cell.IsFilled || _engine.RollCount <= 0)
        {
            return false;
        }

        int[] diceValues = _engine.Dice.Select(d => d.Value).ToArray();
        var evaluation = ScoreRules.EvaluateCategory(category, diceValues);
        return evaluation.IsValid;
    }

    private string GetProbabilityText(ScoreCategory category)
    {
        return _engine.RollCount > 0 && _probabilities.TryGetValue(category, out var p)
            ? p.ToString("P1")
            : string.Empty;
    }

    private string GetUpperPaceText(int gameIndex)
    {
        int net = ScoreRules.UpperCategories.Sum(c => ScoreRules.GetUpperPaceDelta(_engine.Cards[gameIndex], c));
        string sign = net > 0 ? "+" : string.Empty;
        return _engine.IsCardEnabled(gameIndex) ? $"{sign}{net}" : "--";
    }

    private string GetPaceToneClass(int gameIndex)
    {
        if (!_engine.IsCardEnabled(gameIndex))
        {
            return "pace-neutral";
        }

        int net = ScoreRules.UpperCategories.Sum(c => ScoreRules.GetUpperPaceDelta(_engine.Cards[gameIndex], c));
        if (net > 0)
        {
            return "pace-up";
        }

        if (net < 0)
        {
            return "pace-down";
        }

        return "pace-neutral";
    }

    private string GetCardTotalDisplay()
    {
        bool showCardTotal = _engine.Mode == GameMode.Single
            ? _engine.Cards[0].IsComplete
            : _engine.Cards.All(c => c.IsComplete);

        if (!showCardTotal)
        {
            return "--";
        }

        int cardTotal = _engine.Cards.Sum(c => c.GameTotal ?? 0);
        return cardTotal.ToString();
    }

    private static string GetScoreClass(ScoreCellState cell, bool isValid)
    {
        if (cell.IsFilled)
        {
            return "filled";
        }

        return isValid ? "valid" : "empty";
    }

    private static string GetScoreButtonStyle(ScoreCellState cell, bool enabled)
    {
        if (cell.IsFilled)
        {
            string textColor = GetContrastingTextColor(cell.PenColorHex);
            string border = enabled ? "#1F2937" : "#374151";
            return $"background:{cell.PenColorHex};color:{textColor};border-color:{border};";
        }

        return string.Empty;
    }

    private static string GetContrastingTextColor(string backgroundHex)
    {
        if (!TryParseHexColor(backgroundHex, out int r, out int g, out int b))
        {
            return "#FFFFFF";
        }

        double luminance = (0.299 * r) + (0.587 * g) + (0.114 * b);
        return luminance > 145 ? "#111827" : "#FFFFFF";
    }

    private static bool TryParseHexColor(string hex, out int r, out int g, out int b)
    {
        r = g = b = 0;
        if (string.IsNullOrWhiteSpace(hex))
        {
            return false;
        }

        string cleaned = hex.TrimStart('#');
        if (cleaned.Length != 6)
        {
            return false;
        }

        return int.TryParse(cleaned.AsSpan(0, 2), System.Globalization.NumberStyles.HexNumber, null, out r)
            && int.TryParse(cleaned.AsSpan(2, 2), System.Globalization.NumberStyles.HexNumber, null, out g)
            && int.TryParse(cleaned.AsSpan(4, 2), System.Globalization.NumberStyles.HexNumber, null, out b);
    }
}
