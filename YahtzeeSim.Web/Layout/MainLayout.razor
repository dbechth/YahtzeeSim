@inherits LayoutComponentBase
@implements IDisposable
@inject AccountService Account
@inject ScoreQueue Queue
@inject ActionLog Actions
@inject ChallengeService Challenges
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="app-shell">
    <main>
        <InstallBanner />
        @if (Account.State == AccountState.Loading)
        {
            <div class="gate"><p class="gate-lead" role="status">Checking sign in</p></div>
        }
        else if (Account.State == AccountState.SignedOut)
        {
            <SignInGate />
        }
        else if (string.IsNullOrEmpty(Account.Nickname))
        {
            <NicknameGate />
        }
        else
        {
            @Body
        }
    </main>
</div>

@code {
    private DotNetObjectReference<MainLayout>? _self;

    protected override async Task OnInitializedAsync()
    {
        Account.Changed += OnAccountChanged;

        // An invite link (?join=...) has to survive signing in, which leaves the page, so keep its token on the device.
        var query = new Uri(Navigation.Uri).Query;
        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            if (part.StartsWith("join=", StringComparison.Ordinal) && part.Length is > 5 and <= 69)
            {
                await Challenges.SavePendingJoinAsync(Uri.UnescapeDataString(part[5..]));
            }
        }

        await Account.InitializeAsync();
        await Queue.FlushAsync();
        await Actions.FlushAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("yahtzeeSimOnOnline", _self);
        }
        catch (JSException)
        {
            // Without the listener, queued scores simply upload on the next launch.
        }
    }

    [JSInvokable]
    public async Task OnBackOnline()
    {
        if (Account.IsOffline)
        {
            await Account.InitializeAsync();
        }

        await Queue.FlushAsync();
        await Actions.FlushAsync();
        await Challenges.RefreshUnreadAsync();
    }

    private void OnAccountChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Account.Changed -= OnAccountChanged;
        _self?.Dispose();
    }
}