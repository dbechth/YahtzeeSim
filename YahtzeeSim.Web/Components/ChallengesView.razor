@implements IDisposable
@inject ChallengeService Challenges
@inject NotificationService Notifications
@inject AccountService Account

<h3 id="ch-title">@Heading</h3>

<div class="ch-body">
    @if (_view == View.List)
    {
        @Notice()
        <div class="ch-row ch-top">
            <button type="button" class="ch-primary" @onclick="() => StartCreateAsync()">New challenge</button>
            <button type="button" class="ch-secondary" aria-label="@GroupsLabel" @onclick="ShowGroupsAsync">
                Groups
                @if (Challenges.PendingRequests > 0)
                {
                    <span class="ch-count" aria-hidden="true">@Challenges.PendingRequests</span>
                }
            </button>
        </div>
        @if (_list == null)
        {
            <p class="ch-message" role="status">@(_listError == null ? "Loading" : ErrorText(_listError))</p>
        }
        else if (_list.Count == 0)
        {
            <p class="ch-message">No challenges yet Start one and pick who to play against Everyone plays one game and the best score wins</p>
        }
        else
        {
            var open = _list.Where(c => c.IsOpen).ToList();
            var done = _list.Where(c => !c.IsOpen).ToList();
            @if (open.Count > 0)
            {
                <h4 class="ch-section">Open</h4>
                <ul class="ch-list">
                    @foreach (var c in open)
                    {
                        <li>@Card(c)</li>
                    }
                </ul>
            }
            @if (done.Count > 0)
            {
                <h4 class="ch-section">Finished</h4>
                <ul class="ch-list">
                    @foreach (var c in done)
                    {
                        <li>@Card(c)</li>
                    }
                </ul>
            }
        }
        @NotificationRow()
    }
    else if (_view == View.Create)
    {
        <form class="ch-form" @onsubmit="CreateAsync">
            <label for="ch-name">Name</label>
            <input id="ch-name" type="text" maxlength="40" @bind="_title" @bind:event="oninput" />

            <span class="ch-label" id="ch-mode-label">Game</span>
            <div class="ch-seg" role="group" aria-labelledby="ch-mode-label">
                <button type="button" class="@Seg(_mode == "FullSheet")" aria-pressed="@(_mode == "FullSheet" ? "true" : "false")" @onclick='() => _mode = "FullSheet"'>Full Sheet</button>
                <button type="button" class="@Seg(_mode == "Single")" aria-pressed="@(_mode == "Single" ? "true" : "false")" @onclick='() => _mode = "Single"'>Single</button>
            </div>

            <span class="ch-label" id="ch-ends-label">Ends in</span>
            <div class="ch-seg ch-wrap" role="group" aria-labelledby="ch-ends-label">
                @foreach (var (label, hours) in Durations)
                {
                    <button type="button" class="@Seg(_hours == hours)" aria-pressed="@(_hours == hours ? "true" : "false")" @onclick="() => _hours = hours">@label</button>
                }
            </div>
            <p class="ch-fine">Ends @FormatTime(DateTimeOffset.Now.AddHours(_hours)) or as soon as everyone has played</p>

            <label for="ch-search">Players</label>
            @Picker()
            @GroupPicker()
            <p class="ch-fine">You can also share an invite link once it is created Anyone you send it to can join even if they are new</p>

            @if (_formError != null)
            {
                <p class="ch-error" role="alert">@_formError</p>
            }
            <div class="ch-row">
                <button type="submit" class="ch-primary" disabled="@_busy">Create challenge</button>
                <button type="button" class="ch-secondary" @onclick="ShowListAsync">Cancel</button>
            </div>
        </form>
    }
    else if (_view == View.Detail)
    {
        @if (_detail == null)
        {
            <p class="ch-message" role="status">@(_detailError == null ? "Loading" : ErrorText(_detailError))</p>
            <div class="ch-row">
                <button type="button" class="ch-secondary" @onclick="ShowListAsync">Back</button>
            </div>
        }
        else
        {
            var d = _detail;
            var me = d.Me;
            <p class="ch-meta">
                <span class="ch-tag">@ModeName(d.Mode)</span>
                <span>by @d.Creator</span>
                <span>@(d.IsOpen ? "ends " + FormatTime(Time(d.Deadline)) : "finished")</span>
            </p>

            @if (_notice != null)
            {
                <p class="ch-ok" role="status">@_notice</p>
            }

            <table class="ch-table">
                <caption class="ch-sr">Players and scores</caption>
                <thead>
                    <tr><th scope="col">#</th><th scope="col">Player</th><th scope="col" class="ch-num">Score</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in d.Players)
                    {
                        <tr class="@(p.IsMe ? "ch-me" : null)">
                            <td>@(p.Rank?.ToString() ?? "")</td>
                            <td>@p.Nickname@(p.IsMe ? " you" : null)</td>
                            <td class="ch-num">@(p.Total?.ToString() ?? (d.IsOpen ? "to play" : "did not play"))</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (d.IsOpen && me?.Total == null)
            {
                <div class="ch-row">
                    <button type="button" class="ch-primary ch-play" @onclick="() => OnPlay.InvokeAsync(d)">Play your @ModeName(d.Mode) game</button>
                </div>
                <p class="ch-fine">Your first finished game for this challenge counts It also counts on the leaderboard like any other game</p>
            }
            else if (d.IsOpen)
            {
                <p class="ch-fine">You have played Waiting for the others</p>
            }

            @if (d.IsOpen && d.InviteToken != null)
            {
                <div class="ch-row">
                    <button type="button" class="ch-secondary" @onclick="ShareAsync">Share invite link</button>
                    <button type="button" class="ch-secondary" @onclick="ToggleInvitingAsync">Invite players</button>
                </div>
                @if (_inviting)
                {
                    @Picker()
                    @GroupPicker()
                    <div class="ch-row">
                        <button type="button" class="ch-primary" disabled="@(_busy || (_picked.Count == 0 && _pickedGroups.Count == 0))" @onclick="InviteAsync">Send invites</button>
                    </div>
                }
            }

            @NotificationRow()

            <div class="ch-row ch-bottom">
                <button type="button" class="ch-secondary" @onclick="ShowListAsync">All challenges</button>
                <button type="button" class="ch-link" @onclick="LeaveAsync">Leave challenge</button>
            </div>
        }
    }
    else if (_view == View.Groups)
    {
        <div class="ch-row ch-top">
            <button type="button" class="ch-primary" @onclick="StartCreateGroup">New group</button>
        </div>
        @if (_notice != null)
        {
            <p class="ch-ok" role="status">@_notice</p>
        }
        @if (_groups == null)
        {
            <p class="ch-message" role="status">@(_groupsError == null ? "Loading" : GroupErrorText(_groupsError))</p>
        }
        else
        {
            var mine = _groups.Where(g => !g.IsPending).ToList();
            var waiting = _groups.Where(g => g.IsPending).ToList();
            @if (mine.Count == 0)
            {
                <p class="ch-message">You are not in a group yet Start one or find a group below and ask to join</p>
            }
            else
            {
                <h4 class="ch-section">Your groups</h4>
                <ul class="ch-list">
                    @foreach (var g in mine)
                    {
                        <li>
                            <button type="button" class="ch-card" @onclick="() => ShowGroupAsync(g.Id)">
                                <span class="ch-card-top">
                                    <strong>@g.Name</strong>
                                    @if (g.IsAdmin)
                                    {
                                        <span class="ch-tag">Admin</span>
                                    }
                                    @if (g.Requests > 0)
                                    {
                                        <span class="ch-todo">@g.Requests waiting</span>
                                    }
                                </span>
                                <span class="ch-card-sub">@MemberCount(g.Members)</span>
                            </button>
                        </li>
                    }
                </ul>
            }
            @if (waiting.Count > 0)
            {
                <h4 class="ch-section">Waiting for approval</h4>
                <ul class="ch-list">
                    @foreach (var g in waiting)
                    {
                        <li class="ch-found">
                            <span><strong>@g.Name</strong> <span class="ch-card-sub">@MemberCount(g.Members)</span></span>
                            <button type="button" class="ch-link" @onclick="() => WithdrawRequestAsync(g)">Cancel request</button>
                        </li>
                    }
                </ul>
            }
        }

        <h4 class="ch-section">Find a group</h4>
        <label class="ch-sr" for="ch-group-search">Search groups by name</label>
        <input id="ch-group-search" type="search" placeholder="Search by group name" autocomplete="off" autocapitalize="off" spellcheck="false"
               value="@_groupSearch" @oninput="OnGroupSearchInput" />
        @if (_groupSearched && _groupMatches.Count == 0)
        {
            <p class="ch-fine">No groups found</p>
        }
        <ul class="ch-list ch-found-list">
            @foreach (var m in _groupMatches)
            {
                <li class="ch-found">
                    <span><strong>@m.Name</strong> <span class="ch-card-sub">@MemberCount(m.Members)</span></span>
                    @switch (m.Membership)
                    {
                        case "none":
                            <button type="button" class="ch-small ch-small-primary" disabled="@_busy" @onclick="() => AskToJoinAsync(m)">Ask to join</button>
                            break;
                        case "pending":
                            <span class="ch-tag">Waiting</span>
                            break;
                        default:
                            <span class="ch-tag">You are in</span>
                            break;
                    }
                </li>
            }
        </ul>
        <div class="ch-row ch-bottom">
            <button type="button" class="ch-secondary" @onclick="ShowListAsync">All challenges</button>
        </div>
    }
    else if (_view == View.GroupCreate)
    {
        <form class="ch-form" @onsubmit="CreateGroupAsync">
            <label for="ch-group-name">Group name</label>
            <input id="ch-group-name" type="text" maxlength="30" @bind="_groupName" @bind:event="oninput" />
            <p class="ch-fine">You will be the admin New members ask to join and you approve them</p>
            @if (_formError != null)
            {
                <p class="ch-error" role="alert">@_formError</p>
            }
            <div class="ch-row">
                <button type="submit" class="ch-primary" disabled="@_busy">Create group</button>
                <button type="button" class="ch-secondary" @onclick="ShowGroupsAsync">Cancel</button>
            </div>
        </form>
    }
    else if (_view == View.GroupDetail)
    {
        @if (_group == null)
        {
            <p class="ch-message" role="status">@(_groupError == null ? "Loading" : GroupErrorText(_groupError))</p>
            <div class="ch-row">
                <button type="button" class="ch-secondary" @onclick="ShowGroupsAsync">Back</button>
            </div>
        }
        else
        {
            var g = _group;
            <p class="ch-meta">
                <span class="ch-tag">@(g.IsAdmin ? "Admin" : "Member")</span>
                <span>@MemberCount(g.Members.Count)</span>
            </p>
            @if (_notice != null)
            {
                <p class="ch-ok" role="status">@_notice</p>
            }
            @if (g.IsAdmin && g.Requests.Count > 0)
            {
                <h4 class="ch-section">Waiting for approval</h4>
                <ul class="ch-list">
                    @foreach (var nickname in g.Requests)
                    {
                        <li class="ch-found">
                            <strong>@nickname</strong>
                            <span class="ch-btns">
                                <button type="button" class="ch-small ch-small-primary" disabled="@_busy" aria-label="Approve @nickname" @onclick="() => DecideAsync(nickname, true)">Approve</button>
                                <button type="button" class="ch-small" disabled="@_busy" aria-label="Decline @nickname" @onclick="() => DecideAsync(nickname, false)">Decline</button>
                            </span>
                        </li>
                    }
                </ul>
            }
            @if (g.IsAdmin)
            {
                <h4 class="ch-section">Add a player</h4>
                <input id="ch-add-search" type="search" placeholder="Search by nickname" autocomplete="off" autocapitalize="off" spellcheck="false"
                       aria-label="Search players to add" value="@_search" @oninput="OnSearchInput" />
                @if (_matches.Count > 0)
                {
                    <ul class="ch-matches">
                        @foreach (var name in _matches.Where(n => !g.Members.Any(m => string.Equals(m.Nickname, n, StringComparison.OrdinalIgnoreCase))))
                        {
                            <li><button type="button" disabled="@_busy" aria-label="Add @name to the group" @onclick="() => AddMemberAsync(name)">@name</button></li>
                        }
                    </ul>
                }
            }
            <h4 class="ch-section">Members</h4>
            <ul class="ch-list">
                @foreach (var m in g.Members)
                {
                    <li class="ch-found @(m.IsMe ? "ch-me" : null)">
                        <span>
                            <strong>@m.Nickname</strong>@(m.IsMe ? " you" : null)
                            @if (m.IsAdmin)
                            {
                                <span class="ch-tag">Admin</span>
                            }
                        </span>
                        @if (g.IsAdmin)
                        {
                            <span class="ch-btns">
                                @if (!m.IsMe)
                                {
                                    <button type="button" class="ch-small" disabled="@_busy" aria-label="@RoleLabel(m)" @onclick="() => SetRoleAsync(m)">@RoleAction(m)</button>
                                    <button type="button" class="ch-small ch-small-danger" disabled="@_busy" aria-label="Remove @m.Nickname from the group" @onclick="() => RemoveMemberAsync(m)">@(_confirm == "remove:" + m.Nickname ? "Sure" : "Remove")</button>
                                }
                                else if (g.Members.Count(x => x.IsAdmin) > 1)
                                {
                                    <button type="button" class="ch-small" disabled="@_busy" @onclick="() => SetRoleAsync(m)">Step down</button>
                                }
                            </span>
                        }
                    </li>
                }
            </ul>
            <div class="ch-row">
                <button type="button" class="ch-primary" @onclick="() => StartCreateAsync(g.Id)">Challenge this group</button>
            </div>
            <div class="ch-row ch-bottom">
                <button type="button" class="ch-secondary" @onclick="ShowGroupsAsync">All groups</button>
                <button type="button" class="ch-link" @onclick="LeaveGroupAsync">@(_confirm == "leave" ? "Tap again to leave" : "Leave group")</button>
            </div>
        }
    }
</div>

<div class="ch-actions">
    <button type="button" class="ch-close" @onclick="() => OnClose.InvokeAsync()">Close</button>
</div>

@code {
    private enum View { List, Create, Detail, Groups, GroupCreate, GroupDetail }

    private static readonly (string Label, int Hours)[] Durations = [("3 hours", 3), ("1 day", 24), ("2 days", 48), ("3 days", 72), ("1 week", 168)];

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Starts the player's game for this challenge.</summary>
    [Parameter]
    public EventCallback<ChallengeDetail> OnPlay { get; set; }

    /// <summary>Opens straight to this challenge (from a notification or an invite link).</summary>
    [Parameter]
    public string? OpenChallengeId { get; set; }

    /// <summary>Shown once at the top, e.g. why an invite link did not work.</summary>
    [Parameter]
    public string? Message { get; set; }

    /// <summary>Opens straight to this group (from a notification about a join request or an approval).</summary>
    [Parameter]
    public string? OpenGroupId { get; set; }

    private View _view = View.List;
    private List<ChallengeSummary>? _list;
    private string? _listError;
    private ChallengeDetail? _detail;
    private string? _detailError;
    private string? _notice;
    private bool _busy;
    private bool _inviting;

    private string _title = "Full Sheet challenge";
    private string _mode = "FullSheet";
    private int _hours = 24;
    private string? _formError;
    private string _search = string.Empty;
    private List<string> _matches = [];
    private readonly List<string> _picked = [];
    private CancellationTokenSource? _searchCts;

    private List<GroupSummary>? _groups;
    private string? _groupsError;
    private GroupDetail? _group;
    private string? _groupError;
    private string _groupName = string.Empty;
    private string _groupSearch = string.Empty;
    private List<GroupSearchResult> _groupMatches = [];
    private bool _groupSearched;
    private CancellationTokenSource? _groupSearchCts;
    /// <summary>The player's own groups (not pending), offered when creating a challenge or inviting.</summary>
    private List<GroupSummary> _myGroups = [];
    private readonly HashSet<string> _pickedGroups = [];
    /// <summary>The destructive button waiting for a second tap, e.g. "leave" or "remove:Nickname".</summary>
    private string? _confirm;

    private PushState _push = PushState.Unavailable;
    private bool _pushFailed;

    private string Heading => _view switch
    {
        View.Create => "New challenge",
        View.Groups => "Groups",
        View.GroupCreate => "New group",
        View.GroupDetail when _group != null => _group.Name,
        View.Detail when _detail != null => _detail.Title,
        _ => "Challenges"
    };

    protected override async Task OnInitializedAsync()
    {
        if (OpenChallengeId != null)
        {
            await ShowDetailAsync(OpenChallengeId);
        }
        else if (OpenGroupId != null)
        {
            await ShowGroupAsync(OpenGroupId);
        }
        else
        {
            await ShowListAsync();
        }

        _push = await Notifications.GetStateAsync();
    }

    private RenderFragment Notice() => __builder =>
    {
        if (!string.IsNullOrEmpty(Message))
        {
            <p class="ch-error" role="alert">@Message</p>
        }
    };

    private RenderFragment Card(ChallengeSummary c) => __builder =>
    {
        <button type="button" class="ch-card" @onclick="() => ShowDetailAsync(c.Id)">
            <span class="ch-card-top">
                <strong>@c.Title</strong>
                @if (c.Unread)
                {
                    <span class="ch-dot" aria-label="New"></span>
                }
            </span>
            <span class="ch-card-sub">
                @ModeName(c.Mode) by @c.Creator
                @(c.IsOpen ? " ends " + FormatTime(Time(c.Deadline)) : string.Empty)
            </span>
            <span class="ch-card-sub">
                @c.Entries of @c.Players played
                @if (c.MyTotal is int mine)
                {
                    <span class="ch-score">You @mine</span>
                }
                else if (c.IsOpen)
                {
                    <span class="ch-todo">Your turn</span>
                }
            </span>
        </button>
    };

    private RenderFragment Picker() => __builder =>
    {
        <input id="ch-search" type="search" placeholder="Search by nickname" autocomplete="off" autocapitalize="off" spellcheck="false"
               value="@_search" @oninput="OnSearchInput" />
        @if (_picked.Count > 0)
        {
            <div class="ch-chips">
                @foreach (var name in _picked)
                {
                    <button type="button" class="ch-chip" aria-label="Remove @name" @onclick="() => _picked.Remove(name)">@name <span aria-hidden="true">&times;</span></button>
                }
            </div>
        }
        @if (_matches.Count > 0)
        {
            <ul class="ch-matches">
                @foreach (var name in _matches.Where(m => !_picked.Contains(m, StringComparer.OrdinalIgnoreCase)))
                {
                    <li><button type="button" @onclick="() => Pick(name)">@name</button></li>
                }
            </ul>
        }
    };

    private RenderFragment GroupPicker() => __builder =>
    {
        if (_myGroups.Count == 0)
        {
            return;
        }

        <span class="ch-label" id="ch-groups-label">Invite a group</span>
        <div class="ch-seg ch-wrap" role="group" aria-labelledby="ch-groups-label">
            @foreach (var g in _myGroups)
            {
                string id = g.Id;
                <button type="button" class="@Seg(_pickedGroups.Contains(id))" aria-pressed="@(_pickedGroups.Contains(id) ? "true" : "false")" @onclick="() => ToggleGroup(id)">@g.Name @g.Members</button>
            }
        </div>
    };

    private RenderFragment NotificationRow() => __builder =>
    {
        switch (_push)
        {
            case PushState.On:
                <p class="ch-push">Notifications are on for this device <button type="button" class="ch-link" @onclick="TurnOffAsync">Turn off</button></p>
                break;
            case PushState.Off:
                <div class="ch-push ch-push-ask">
                    <span>Get a notification when you are challenged and when others play</span>
                    <button type="button" class="ch-primary" @onclick="TurnOnAsync">Turn on notifications</button>
                    @if (_pushFailed)
                    {
                        <span class="ch-error" role="alert">Notifications could not be turned on Try again in a moment</span>
                    }
                </div>
                break;
            case PushState.NeedsInstall:
                <p class="ch-push">To get notifications on iPhone or iPad add YahtzeeSim to your Home Screen first Tap Share then Add to Home Screen and open it from there</p>
                break;
            case PushState.Blocked:
                <p class="ch-push">Notifications are blocked for YahtzeeSim Turn them on in your browser or phone settings</p>
                break;
        }
    };

    private async Task ShowListAsync()
    {
        _view = View.List;
        _detail = null;
        _notice = null;
        _listError = null;
        _list = null;
        StateHasChanged();
        var result = await Challenges.ListAsync();
        _list = result.Value;
        _listError = result.Error;
    }

    private async Task ShowDetailAsync(string id)
    {
        _view = View.Detail;
        _detail = null;
        _detailError = null;
        _inviting = false;
        ResetPicker();
        StateHasChanged();
        var result = await Challenges.GetAsync(id);
        _detail = result.Value;
        _detailError = result.Error;
        if (_detail != null)
        {
            await Challenges.MarkSeenAsync(id);
        }
    }

    private async Task StartCreateAsync(string? groupId = null)
    {
        _view = View.Create;
        _title = "Full Sheet challenge";
        _mode = "FullSheet";
        _hours = 24;
        _formError = null;
        ResetPicker();
        if (groupId != null)
        {
            _pickedGroups.Add(groupId);
        }

        await LoadMyGroupsAsync();
    }

    private async Task LoadMyGroupsAsync()
    {
        var result = await Challenges.ListGroupsAsync();
        _myGroups = result.Value?.Where(g => !g.IsPending).ToList() ?? [];
        _pickedGroups.IntersectWith(_myGroups.Select(g => g.Id));
    }

    private void ToggleGroup(string id)
    {
        if (!_pickedGroups.Remove(id))
        {
            _pickedGroups.Add(id);
        }
    }

    private async Task ToggleInvitingAsync()
    {
        _inviting = !_inviting;
        if (_inviting)
        {
            await LoadMyGroupsAsync();
        }
    }

    private async Task CreateAsync()
    {
        string title = _title.Trim();
        if (title.Length == 0)
        {
            _formError = "Give the challenge a name";
            return;
        }

        _busy = true;
        _formError = null;
        bool invitedAnyone = _picked.Count > 0 || _pickedGroups.Count > 0;
        var result = await Challenges.CreateAsync(title, _mode, DateTimeOffset.Now.AddHours(_hours), _picked, _pickedGroups);
        _busy = false;
        if (result.Value is not { } created)
        {
            _formError = ErrorText(result.Error);
            return;
        }

        await ShowDetailAsync(created.Id);
        _notice = created.Missing.Count > 0
            ? $"Challenge created but these players were not found {string.Join(" ", created.Missing)}"
            : invitedAnyone ? "Challenge created and players invited" : "Challenge created Share the invite link to add players";
    }

    private async Task InviteAsync()
    {
        if (_detail == null || (_picked.Count == 0 && _pickedGroups.Count == 0))
        {
            return;
        }

        _busy = true;
        var result = await Challenges.InviteAsync(_detail.Id, _picked, _pickedGroups);
        _busy = false;
        string id = _detail.Id;
        await ShowDetailAsync(id);
        _notice = result.Ok ? "Invites sent" : ErrorText(result.Error);
    }

    private async Task ShareAsync()
    {
        if (_detail?.InviteToken is not { } token)
        {
            return;
        }

        string url = Challenges.InviteUrl(token);
        string outcome = await Notifications.ShareAsync(_detail.Title, $"{Account.Nickname} challenged you to a game of YahtzeeSim", url);
        _notice = outcome switch
        {
            "copied" => "Invite link copied Paste it into a message",
            "failed" => "Could not share the link " + url,
            _ => null
        };
    }

    private async Task LeaveAsync()
    {
        if (_detail != null && await Challenges.LeaveAsync(_detail.Id))
        {
            await ShowListAsync();
            await Challenges.RefreshUnreadAsync();
        }
    }

    private async Task TurnOnAsync()
    {
        _push = await Notifications.TurnOnAsync();
        _pushFailed = _push == PushState.Off;
        if (_push == PushState.On)
        {
            _notice = "Notifications are on";
        }
    }

    private async Task TurnOffAsync() => _push = await Notifications.TurnOffAsync();

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        var cts = _searchCts = new CancellationTokenSource();
        if (_search.Trim().Length == 0)
        {
            _matches = [];
            return;
        }

        try
        {
            await Task.Delay(250, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        var found = await Challenges.SearchPlayersAsync(_search);
        if (!cts.IsCancellationRequested)
        {
            _matches = found;
            StateHasChanged();
        }
    }

    private void Pick(string name)
    {
        if (!_picked.Contains(name, StringComparer.OrdinalIgnoreCase) && _picked.Count < 19)
        {
            _picked.Add(name);
        }

        _search = string.Empty;
        _matches = [];
    }

    private void ResetPicker()
    {
        _picked.Clear();
        _pickedGroups.Clear();
        _matches = [];
        _search = string.Empty;
    }

    private async Task ShowGroupsAsync()
    {
        _view = View.Groups;
        _group = null;
        _notice = null;
        _confirm = null;
        _groupsError = null;
        _groupSearch = string.Empty;
        _groupMatches = [];
        _groupSearched = false;
        await LoadGroupsAsync();
    }

    private async Task LoadGroupsAsync()
    {
        _groups = null;
        StateHasChanged();
        var result = await Challenges.ListGroupsAsync();
        _groups = result.Value;
        _groupsError = result.Error;
    }

    private async Task ShowGroupAsync(string id)
    {
        _view = View.GroupDetail;
        _group = null;
        _search = string.Empty;
        _matches = [];
        _groupError = null;
        _notice = null;
        _confirm = null;
        StateHasChanged();
        var result = await Challenges.GetGroupAsync(id);
        _group = result.Value;
        _groupError = result.Error;
    }

    private void StartCreateGroup()
    {
        _view = View.GroupCreate;
        _groupName = string.Empty;
        _formError = null;
    }

    private async Task CreateGroupAsync()
    {
        string name = _groupName.Trim();
        if (name.Length == 0)
        {
            _formError = "Give the group a name";
            return;
        }

        _busy = true;
        _formError = null;
        var result = await Challenges.CreateGroupAsync(name);
        _busy = false;
        if (result.Value is not { } id)
        {
            _formError = GroupErrorText(result.Error);
            return;
        }

        await ShowGroupAsync(id);
        _notice = "Group created Players can find it by name and ask to join";
    }

    private async Task OnGroupSearchInput(ChangeEventArgs e)
    {
        _groupSearch = e.Value?.ToString() ?? string.Empty;
        _groupSearchCts?.Cancel();
        var cts = _groupSearchCts = new CancellationTokenSource();
        if (_groupSearch.Trim().Length == 0)
        {
            _groupMatches = [];
            _groupSearched = false;
            return;
        }

        try
        {
            await Task.Delay(250, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        var found = await Challenges.SearchGroupsAsync(_groupSearch);
        if (!cts.IsCancellationRequested)
        {
            _groupMatches = found;
            _groupSearched = true;
            StateHasChanged();
        }
    }

    private async Task AskToJoinAsync(GroupSearchResult match)
    {
        _busy = true;
        string? error = await Challenges.RequestToJoinGroupAsync(match.Id);
        _busy = false;
        if (error == null)
        {
            _groupMatches = _groupMatches.Select(m => m.Id == match.Id ? m with { Membership = "pending" } : m).ToList();
            await LoadGroupsAsync();
            _notice = "Request sent An admin of the group will approve you";
        }
        else
        {
            _notice = GroupErrorText(error);
        }
    }

    private async Task WithdrawRequestAsync(GroupSummary group)
    {
        string? error = await Challenges.LeaveGroupAsync(group.Id);
        await LoadGroupsAsync();
        _groupMatches = _groupMatches.Select(m => m.Id == group.Id ? m with { Membership = "none" } : m).ToList();
        _notice = error == null ? "Request cancelled" : GroupErrorText(error);
    }

    private async Task DecideAsync(string nickname, bool approve)
    {
        if (_group == null)
        {
            return;
        }

        string id = _group.Id;
        _busy = true;
        string? error = await Challenges.DecideGroupRequestAsync(id, nickname, approve);
        _busy = false;
        await ShowGroupAsync(id);
        _notice = error != null ? GroupErrorText(error) : approve ? $"{nickname} is now in the group" : $"{nickname} was declined";
    }

    private async Task AddMemberAsync(string nickname)
    {
        if (_group == null)
        {
            return;
        }

        string id = _group.Id;
        _busy = true;
        var result = await Challenges.AddGroupMemberAsync(id, nickname);
        _busy = false;
        await ShowGroupAsync(id);
        _notice = result.Error != null ? GroupErrorText(result.Error)
            : result.Value ? $"{nickname} was added to the group" : $"{nickname} is already in the group";
    }

    private async Task SetRoleAsync(GroupMember member)
    {
        if (_group == null)
        {
            return;
        }

        string id = _group.Id;
        _busy = true;
        string? error = await Challenges.SetGroupRoleAsync(id, member.Nickname, member.IsAdmin ? "member" : "admin");
        _busy = false;
        await ShowGroupAsync(id);
        _notice = error != null ? GroupErrorText(error)
            : member.IsMe ? "You are no longer an admin"
            : member.IsAdmin ? $"{member.Nickname} is no longer an admin" : $"{member.Nickname} is now an admin";
    }

    private async Task RemoveMemberAsync(GroupMember member)
    {
        if (_group == null)
        {
            return;
        }

        if (_confirm != "remove:" + member.Nickname)
        {
            _confirm = "remove:" + member.Nickname;
            return;
        }

        string id = _group.Id;
        _busy = true;
        string? error = await Challenges.RemoveGroupMemberAsync(id, member.Nickname);
        _busy = false;
        await ShowGroupAsync(id);
        _notice = error != null ? GroupErrorText(error) : $"{member.Nickname} was removed";
    }

    private async Task LeaveGroupAsync()
    {
        if (_group == null)
        {
            return;
        }

        if (_confirm != "leave")
        {
            _confirm = "leave";
            return;
        }

        string? error = await Challenges.LeaveGroupAsync(_group.Id);
        if (error == null)
        {
            await ShowGroupsAsync();
        }
        else
        {
            _confirm = null;
            _notice = GroupErrorText(error);
        }
    }

    private static string RoleAction(GroupMember m) => m.IsAdmin ? "Remove admin" : "Make admin";

    private static string RoleLabel(GroupMember m) => m.IsAdmin ? $"Remove admin from {m.Nickname}" : $"Make {m.Nickname} an admin";

    private static string MemberCount(int count) => count == 1 ? "1 member" : $"{count} members";

    private string GroupsLabel => Challenges.PendingRequests > 0 ? $"Groups {Challenges.PendingRequests} waiting for approval" : "Groups";

    private static string Seg(bool active) => active ? "ch-seg-btn active" : "ch-seg-btn";

    private static string ModeName(string mode) => mode == "FullSheet" ? "Full Sheet" : "Single";

    private static DateTimeOffset Time(long ms) => DateTimeOffset.FromUnixTimeMilliseconds(ms).ToLocalTime();

    private static string FormatTime(DateTimeOffset t)
    {
        var now = DateTimeOffset.Now;
        string clock = t.ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture);
        if (t.Date == now.Date)
        {
            return "today " + clock;
        }

        if (t.Date == now.Date.AddDays(1))
        {
            return "tomorrow " + clock;
        }

        return t.ToString("ddd MMM d", System.Globalization.CultureInfo.InvariantCulture) + " " + clock;
    }

