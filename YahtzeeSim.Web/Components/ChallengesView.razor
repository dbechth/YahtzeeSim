        "rate_limited" => "You have started a lot of challenges today Try again tomorrow",
        "too_many_players" => "A challenge can have up to 20 players",
        "group_not_found" => "You can only invite groups you are in",
        "invalid_groups" => "Pick groups from your list",
        "invalid_title" => "Use letters numbers and simple punctuation for the name",
        "deadline_out_of_range" => "Pick an end time between one hour and one week from now",
        "nickname_required" => "Pick a nickname first",
        "signed_out" => "Sign in again to use challenges",
        _ => "Something went wrong Try again"
    };

    private static string GroupErrorText(string? error) => error switch
    {
        "offline" => "Groups need a connection",
        "not_found" => "That group is not available You may not be in it any more",
        "forbidden" => "Only group admins can do that",
        "user_not_found" => "No player has that nickname",
        "name_taken" => "A group with that name already exists",
        "invalid_name" => "Use letters numbers and simple punctuation for the name",
        "group_full" => "That group is full It can have up to 20 members",
        "rate_limited" => "You have started a lot of groups today Try again tomorrow",
        "too_many_requests" => "You have a lot of requests waiting Wait for some to be answered",
        "last_admin" => "A group needs at least one admin Make someone else an admin first",
        "cannot_remove_self" => "Use Leave group to leave",
        "nickname_required" => "Pick a nickname first",
        "signed_out" => "Sign in again to use groups",
