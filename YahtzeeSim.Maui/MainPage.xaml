<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YahtzeeSim.Maui.MainPage"
             BackgroundColor="#F4EFE7">
    <Grid>
        <Grid Padding="6,6" RowSpacing="6"
              RowDefinitions="Auto,Auto,Auto,*,Auto">
            <Grid x:Name="TopBarGrid" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                <Label x:Name="AppTitleLabel" Text="Yahtzee"
                       FontSize="24"
                       FontFamily="Georgia"
                       FontAttributes="Bold"
                       TextColor="#1B4332" />

                <Label Grid.Column="1"
                       x:Name="StatusLabel"
                       FontSize="12"
                       LineBreakMode="TailTruncation"
                       MaxLines="2"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       TextColor="#5C4A2D" />

                <Button Grid.Column="2"
                        x:Name="StartGameButton"
                        Text="New Game"
                        HeightRequest="42"
                        Padding="12,0"
                        Clicked="StartGameButton_Clicked"
                        BackgroundColor="#2D6A4F"
                        TextColor="White"
                        FontAttributes="Bold" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4">
                <Button Grid.Column="0" x:Name="Die1Button" Clicked="DieButton_Clicked" CommandParameter="1" HeightRequest="72" FontSize="40" FontFamily="Segoe UI Symbol" Padding="0" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                <Button Grid.Column="1" x:Name="Die2Button" Clicked="DieButton_Clicked" CommandParameter="2" HeightRequest="72" FontSize="40" FontFamily="Segoe UI Symbol" Padding="0" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                <Button Grid.Column="2" x:Name="Die3Button" Clicked="DieButton_Clicked" CommandParameter="3" HeightRequest="72" FontSize="40" FontFamily="Segoe UI Symbol" Padding="0" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                <Button Grid.Column="3" x:Name="Die4Button" Clicked="DieButton_Clicked" CommandParameter="4" HeightRequest="72" FontSize="40" FontFamily="Segoe UI Symbol" Padding="0" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                <Button Grid.Column="4" x:Name="Die5Button" Clicked="DieButton_Clicked" CommandParameter="5" HeightRequest="72" FontSize="40" FontFamily="Segoe UI Symbol" Padding="0" HorizontalOptions="Fill" VerticalOptions="Fill"/>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="8*,2*" ColumnSpacing="6">
                <Button Grid.Column="0" x:Name="RollButton" Text="Roll" HeightRequest="56" Pressed="RollButton_Pressed" Released="RollButton_Released" BackgroundColor="#2A9D8F" TextColor="White" FontAttributes="Bold"/>
                <Button Grid.Column="1" x:Name="UndoButton" Text="Undo" HeightRequest="56" Clicked="UndoButton_Clicked" BackgroundColor="#E76F51" TextColor="White" FontAttributes="Bold"/>
            </Grid>

            <ScrollView Grid.Row="3"
                        x:Name="ScoreScroll"
                        Orientation="Neither"
                        VerticalScrollBarVisibility="Never"
                        HorizontalScrollBarVisibility="Never">
                <Border Stroke="#7F5539" StrokeThickness="2" BackgroundColor="#FFFDF8" Padding="2" StrokeShape="RoundRectangle 8">
                    <Grid x:Name="ScoreGrid" ColumnSpacing="1" RowSpacing="1" HorizontalOptions="Start" />
                </Border>
            </ScrollView>

                <Border Grid.Row="4"
                    x:Name="EndSummaryPanel"
                    IsVisible="False"
                    Stroke="#3A5A40"
                    StrokeThickness="2"
                    BackgroundColor="#E9F5DB"
                    Padding="10"
                    StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="4">
                          <Label Text="Full Sheet Complete"
                           FontFamily="Georgia"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1B4332" />
                    <Label x:Name="EndSummaryText"
                           FontSize="12"
                           TextColor="#2D6A4F" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid x:Name="ColorPickerOverlay"
              IsVisible="False"
              BackgroundColor="#90000000"
              Padding="24">
            <Border VerticalOptions="Center"
                    Stroke="#8B5E34"
                    StrokeThickness="2"
                    BackgroundColor="#FFFBEB"
                    StrokeShape="RoundRectangle 12"
                    Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="ColorPickerTitle"
                           FontFamily="Georgia"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="#5C3A21"
                           Text="Pick Pen Color" />

                    <Grid ColumnDefinitions="*,*,*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Button Grid.Row="0" Grid.Column="0" BackgroundColor="#7F1D1D" Clicked="ColorSwatch_Clicked" CommandParameter="#7F1D1D" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                        <Button Grid.Row="1" Grid.Column="0" BackgroundColor="#B91C1C" Clicked="ColorSwatch_Clicked" CommandParameter="#B91C1C" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                        <Button Grid.Row="2" Grid.Column="0" BackgroundColor="#EF4444" Clicked="ColorSwatch_Clicked" CommandParameter="#EF4444" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                        <Button Grid.Row="3" Grid.Column="0" BackgroundColor="#FCA5A5" Clicked="ColorSwatch_Clicked" CommandParameter="#FCA5A5" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />

                        <Button Grid.Row="0" Grid.Column="1" BackgroundColor="#7C2D12" Clicked="ColorSwatch_Clicked" CommandParameter="#7C2D12" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                        <Button Grid.Row="1" Grid.Column="1" BackgroundColor="#C2410C" Clicked="ColorSwatch_Clicked" CommandParameter="#C2410C" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                        <Button Grid.Row="2" Grid.Column="1" BackgroundColor="#F97316" Clicked="ColorSwatch_Clicked" CommandParameter="#F97316" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                        <Button Grid.Row="3" Grid.Column="1" BackgroundColor="#FDBA74" Clicked="ColorSwatch_Clicked" CommandParameter="#FDBA74" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />

                        <Button Grid.Row="0" Grid.Column="2" BackgroundColor="#854D0E" Clicked="ColorSwatch_Clicked" CommandParameter="#854D0E" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                        <Button Grid.Row="1" Grid.Column="2" BackgroundColor="#CA8A04" Clicked="ColorSwatch_Clicked" CommandParameter="#CA8A04" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                        <Button Grid.Row="2" Grid.Column="2" BackgroundColor="#FACC15" Clicked="ColorSwatch_Clicked" CommandParameter="#FACC15" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                        <Button Grid.Row="3" Grid.Column="2" BackgroundColor="#FDE68A" Clicked="ColorSwatch_Clicked" CommandParameter="#FDE68A" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />

                        <Button Grid.Row="0" Grid.Column="3" BackgroundColor="#166534" Clicked="ColorSwatch_Clicked" CommandParameter="#166534" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                        <Button Grid.Row="1" Grid.Column="3" BackgroundColor="#16A34A" Clicked="ColorSwatch_Clicked" CommandParameter="#16A34A" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                        <Button Grid.Row="2" Grid.Column="3" BackgroundColor="#4ADE80" Clicked="ColorSwatch_Clicked" CommandParameter="#4ADE80" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                        <Button Grid.Row="3" Grid.Column="3" BackgroundColor="#BBF7D0" Clicked="ColorSwatch_Clicked" CommandParameter="#BBF7D0" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />

                        <Button Grid.Row="0" Grid.Column="4" BackgroundColor="#1E3A8A" Clicked="ColorSwatch_Clicked" CommandParameter="#1E3A8A" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                        <Button Grid.Row="1" Grid.Column="4" BackgroundColor="#2563EB" Clicked="ColorSwatch_Clicked" CommandParameter="#2563EB" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                        <Button Grid.Row="2" Grid.Column="4" BackgroundColor="#60A5FA" Clicked="ColorSwatch_Clicked" CommandParameter="#60A5FA" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                        <Button Grid.Row="3" Grid.Column="4" BackgroundColor="#BFDBFE" Clicked="ColorSwatch_Clicked" CommandParameter="#BFDBFE" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />

                        <Button Grid.Row="0" Grid.Column="5" BackgroundColor="#581C87" Clicked="ColorSwatch_Clicked" CommandParameter="#581C87" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                        <Button Grid.Row="1" Grid.Column="5" BackgroundColor="#7E22CE" Clicked="ColorSwatch_Clicked" CommandParameter="#7E22CE" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                        <Button Grid.Row="2" Grid.Column="5" BackgroundColor="#C084FC" Clicked="ColorSwatch_Clicked" CommandParameter="#C084FC" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                        <Button Grid.Row="3" Grid.Column="5" BackgroundColor="#E9D5FF" Clicked="ColorSwatch_Clicked" CommandParameter="#E9D5FF" CornerRadius="18" HeightRequest="36" WidthRequest="36" Text="" />
                    </Grid>

                    <Button x:Name="KeepColorButton"
                            IsVisible="False"
                            Text="Keep Current"
                            Clicked="KeepColorButton_Clicked"
                            BackgroundColor="#D1D5DB"
                            TextColor="#1F2937"
                            HeightRequest="42" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
