# Default to ignoring everything, then allow only source/deployment files.
*

# Allow directory traversal so unignore rules can apply.
!*/

# Repository and deployment metadata.
!.gitignore
!README.md
!TODO.md
!YahtzeeSim.sln
!.github/
!.github/workflows/
!.github/workflows/*.yml
!scripts/
!scripts/*.ps1

# Keep source and project files.
!**/*.sln
!**/*.csproj
!**/*.props
!**/*.targets
!**/*.cs
!**/*.razor
!**/*.css
!**/*.html
!**/*.js
!**/*.json
!**/*.webmanifest
!**/*.xaml
!**/*.resx
!**/*.md
!**/*.xml
!**/*.plist
!**/*.manifest
!**/*.appxmanifest
!**/*.png
!**/*.ico
!**/*.svg
!**/*.ts
!**/*.sql
!wrangler.toml
# Precomputed strategy data shipped with the app (see scripts/analyze-strategy.ps1).
!YahtzeeSim.Web/wwwroot/analysis/*.bin
!.dev.vars.example

# Always ignore generated artifacts and local IDE state.
**/bin/**
**/obj/**
.vs/**
**/*.user
**/*.suo
**/*.cache
**/*.pdb
**/*.dll
**/*.exe
**/*.deps.json
**/*.runtimeconfig.json
**/*.nupkg
**/*.snupkg

# Node tooling (Pages Functions) and local secrets.
**/node_modules/**
.wrangler/**
.dev.vars

# Downloaded gameplay data (personal data, never commit).
exports/
